---
/**
 * KATALOG-LISTE – die Übersicht mit Filter, Sortierung und Merkliste.
 *
 * Die Filtergruppen und Schieberegler entstehen AUTOMATISCH aus den Daten:
 * Jeder Schlüssel unter `filter` wird eine Knopfgruppe, jeder unter `zahlen`
 * ein Regler. Kommt ein neues Merkmal in die Config, ist es sofort filterbar –
 * ohne dass jemand die Seite anfassen muss. Und es steht nie eine Auswahl da,
 * die null Treffer hätte, weil die Werte aus den Einträgen selbst kommen.
 *
 * Das AUSSEHEN kommt aus dem Design. Beim Portieren wird die Karte hier durch
 * die Karte aus dem Design ersetzt – die data-Attribute (`katalogAttribute`)
 * müssen dabei erhalten bleiben, sonst filtert nichts mehr.
 */
import { Picture } from 'astro:assets';
import { site } from '../../content.config';
import { bild } from '../lib/bilder';
import {
  katalogEintraege,
  katalogAdresse,
  katalogAttribute,
  preisText,
  beschriftung,
  filterGruppen,
  regler as reglerAbleiten,
  sortierOptionen,
} from '../lib/katalog';

const katalog = site.katalog!;
const eintraege = katalogEintraege();

/* Die Ableitungen kommen aus src/lib/katalog.ts, nicht von hier.
   WARUM: Diese Komponente ist ein BEISPIEL. Ein echtes Design ersetzt nicht
   nur die Karte, sondern die ganze Filterleiste – und ein Klon, der sie neu
   baut, würde jede spätere Motor-Korrektur verpassen (im Kundenprojekt genau
   so passiert: der Regler-Fehler musste dort zweimal repariert werden).
   Wer eigenes Markup schreibt, ruft dieselben drei Funktionen auf. */
const gruppen = filterGruppen();
const regler = reglerAbleiten();
const sortierungen = sortierOptionen();
---

<div class="katalog" data-filter data-filter-kombi>
  <div class="katalog__steuerung">
    {gruppen.map((g) => (
      <fieldset class="katalog__gruppe" data-filter-gruppe={g.name}>
        <legend>{beschriftung(g.name)}</legend>
        <button type="button" data-filter-wert="alle" aria-pressed="true">Alle</button>
        {g.werte.map((w) => (
          <button type="button" data-filter-wert={w}>{beschriftung(w)}</button>
        ))}
      </fieldset>
    ))}

    {regler.map((r) => (
      <p class="katalog__regler">
        <label for={`regler-${r.name}`}>{beschriftung(r.name)} bis</label>
        <input
          type="range"
          id={`regler-${r.name}`}
          data-filter-max={r.name}
          min={r.min}
          max={r.max}
          step={r.step}
          value={r.max}
        />
        <output data-filter-max-anzeige={r.name}></output>
      </p>
    ))}

    <p class="katalog__ordnen">
      <label for="katalog-sortierung">Sortierung</label>
      <select id="katalog-sortierung" data-filter-sortierung>
        <option value="">Wie gepflegt</option>
        {sortierungen.map((s) => (
          <option value={s.wert}>
            {beschriftung(s.merkmal)} {s.richtung === 'auf' ? 'aufsteigend' : 'absteigend'}
          </option>
        ))}
      </select>
      <button type="button" data-filter-zuruecksetzen>Zurücksetzen</button>
      {/* `id="merkliste"` ist kein Beiwerk: Der Weg zur Merkliste ist ein
          gewöhnlicher Link (`/fahrzeuge#merkliste`). Der Baustein schaltet den
          Filter beim Ankommen selbst ein – aber OHNE JavaScript muss der Link
          wenigstens an die richtige Stelle springen, statt ins Leere zu laufen.
          Das Prüf-Tor kontrolliert genau das. */}
      <button type="button" id="merkliste" data-merkliste-nur>Nur Vorgemerkte</button>
    </p>

    {/* Erst der Gegenstand, dann die Zahlen: "Fahrzeuge: 3 von 12" geht in
        jeder Branche auf. "3 von 12 Fahrzeuge" waere falsch gebeugt, und die
        richtige Beugung kann der Motor nicht raten. Die Leerzeichen stehen
        ausdruecklich da - ohne sie las die Zeile "3 von12". */}
    <p class="katalog__zahl" aria-live="polite">
      {katalog.mehrzahl}: <span data-filter-anzahl>{eintraege.length}</span>
      {' von '}
      <span data-filter-gesamt>{eintraege.length}</span>
    </p>
  </div>

  <p class="katalog__leer" data-filter-leer hidden>
    Zu dieser Auswahl gibt es gerade nichts. Bitte einen Filter zurücknehmen.
  </p>

  <div class="katalog__liste" data-filter-ziel>
    {eintraege.map((e, i) => {
      const foto = e.bilder?.[0] ? bild(e.bilder[0]) : undefined;
      return (
        <article class="katalog__karte" {...katalogAttribute(e)}>
          {foto && (
            <a href={katalogAdresse(e)} tabindex="-1" aria-hidden="true">
              {/* <Picture> mit JPEG-Ersatzfassung - siehe index.astro.

                  Das erste Bild ist auf einer Katalogseite fast immer das, was
                  den ersten Eindruck bestimmt (LCP). Mit `lazy` startet es erst
                  spät und die Seite wirkt träge – die Sichtprüfung schlug genau
                  deshalb an. Deshalb `eager` und `fetchpriority="high"` beim
                  ersten Eintrag.

                  ACHTUNG, sonst bricht die Typprüfung: Dieser Kommentar steht
                  VOR dem Element, nicht zwischen seinen Attributen. Ein
                  geschweifter JSX-Kommentar ist nur als KIND eines Elements
                  gültig; Astro rendert ihn zwar auch zwischen Attributen,
                  `astro check` bricht dort aber mit „Unterminated string
                  literal" ab – und reisst den Typ der ganzen Datei mit. Am
                  30.07.2026 an drei Motor-Dateien gemessen, als die Typprüfung
                  zum ersten Mal lief. */}
              <Picture
                formats={['webp']}
                fallbackFormat="jpeg"
                src={foto}
                alt=""
                widths={[300, 600, 900, 1440]}
                sizes="(min-width: 800px) 33vw, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </a>
          )}
          <h3>
            {/* Der Titel ist der Link – so ist das Ziel auch beim Vorlesen der
                Linkliste eindeutig („BMW 320d" statt „hier"). */}
            <a href={katalogAdresse(e)}>{e.titel}</a>
          </h3>
          {e.kurz && <p class="katalog__kurz">{e.kurz}</p>}
          <p class="katalog__preis">{preisText(e)}</p>
          <button type="button" data-merken={e.id} aria-label={`${e.titel} vormerken`}>
            Merken
          </button>
        </article>
      );
    })}
  </div>
</div>

<style>
  /* TIPPFLÄCHEN AM HANDY – 44 px, in der Komponente statt im Grundstil.
     Diese Beispiel-Liste ist bewusst fast ungestaltet (das Aussehen kommt vom
     Design), aber BEDIENBAR muss sie sein: Ihre Knöpfe und Auswahlfelder maßen
     bei 350 px zwischen 20 und 25 px Höhe. Der Merk-Knopf auf der Karte war
     mit 25 × 25 px der schlimmste – er liegt über einem Foto, daneben tippt
     man zuverlässig.
     Hier ist `min-height` richtig und kein Pseudo-Element nötig: Es gibt keine
     Design-Vorgabe, an der sich etwas verschieben könnte. Wer die Liste beim
     Port ersetzt, nimmt die Regel mit. */
  @media (max-width: 640px) {
    .katalog button,
    .katalog select,
    .katalog input[type='range'] {
      min-height: 44px;
      /* Auch die BREITE: Ein Filterknopf mit kurzer Beschriftung („A", „XL",
         „SUV") maß 25 px. Die Höhe allein hilft dort nichts. */
      min-width: 44px;
    }
    /* Der Merk-Knopf liegt über einem Foto – die Breite zählt hier genauso wie
       die Höhe.

       HIER STAND `width: 44px`, UND DAS WAR FALSCH: Eine feste Breite ist eine
       OBERgrenze. Trägt der Knopf im Design ein Wort statt eines Symbols
       („Merken", „Vormerken"), presst sie es auf 44 px zusammen und die
       Beschriftung bricht mitten im Wort um. `min-width` ist genau das
       Richtige: Es hebt zu kleine Knöpfe an und lässt breitere in Ruhe. */
    .katalog__karte button[data-merken] {
      min-width: 44px;
      min-height: 44px;
    }
  }

  /* Nur das Nötige, damit die Liste ohne Design brauchbar ist und bei 350 px
     nicht überläuft. min() ist Pflicht – sonst schiebt die Spaltenbreite. */
  .katalog {
    display: grid;
    gap: var(--raum-m);
  }
  .katalog__liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--raum-s);
  }
  .katalog__karte {
    display: grid;
    gap: var(--raum-2xs);
    align-content: start;
  }
  .katalog__karte :global(img) {
    width: 100%;
    height: auto;
  }
  .katalog__steuerung {
    display: grid;
    gap: var(--raum-s);
  }
  .katalog__gruppe {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2xs);
    align-items: baseline;
  }
  .katalog__regler,
  .katalog__ordnen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2xs);
    align-items: center;
  }
</style>
