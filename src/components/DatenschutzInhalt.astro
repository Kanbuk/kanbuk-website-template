---
/**
 * DER INHALT DER DATENSCHUTZERKLÄRUNG – EINMAL, IN ZWEI SPRACHEN.
 * ===========================================================================
 * WARUM ES DIESE DATEI GIBT:
 *
 * Eine zweite Sprachfassung war bisher eine vollständige Handkopie der Seite,
 * mit einem Warnsatz im Dateikopf: „inhaltlich identisch – wird dort etwas
 * geändert, MUSS es hier mitgeändert werden." Das ist ehrlich, aber es ist
 * genau die Sorte Zusage, die eine Datei nicht halten kann.
 *
 * Und der Motor entwickelt diese Erklärung ständig weiter: der
 * Drittland-Absatz, der Merklisten-Absatz, die Einbettungs-Suche im Markup,
 * der Widerruf nach Art. 7 Abs. 2 – alles Änderungen der letzten Wochen. Jede
 * einzelne hätte eine Kopie zurückfallen lassen. Ein Rechtstext, der in einer
 * Sprache älter ist als in der anderen, ist genau der Fehler, gegen den dieser
 * ganze Abschnitt gebaut ist.
 *
 * Deshalb: Der Aufbau steht EINMAL hier, die Sätze stehen daneben in beiden
 * Sprachen. Eine neue Bedingung kann gar nicht nur in einer Fassung landen –
 * sie steht im Markup, und das gibt es nur einmal.
 *
 * SO ENTSTEHT DIE ENGLISCHE ROUTE (im Klon, drei Zeilen):
 *
 *   ---
 *   import RechtsLayout from '../../layouts/RechtsLayout.astro';
 *   import DatenschutzInhalt from '../../components/DatenschutzInhalt.astro';
 *   ---
 *   <RechtsLayout titel="Privacy policy" pfad="/datenschutz" sprache="en"
 *     beschreibung={…}><DatenschutzInhalt sprache="en" /></RechtsLayout>
 *
 * Sobald `src/pages/en/datenschutz.astro` existiert, ziehen die
 * Sprachverweise (hreflang) und der Link unter dem Zustimmungs-Häkchen von
 * selbst nach – beide fragen das Verzeichnis (src/lib/sprachrouten.ts).
 *
 * IMPRESSUM UND AGB BLEIBEN EINSPRACHIG, und das ist Absicht: Das Impressum
 * ist eine Pflichtangabe nach österreichischem Recht mit festen Begriffen
 * (Firmenbuch, UID, Gewerbe) – eine Übersetzung erfindet dafür Wörter, die im
 * Register nicht vorkommen. AGB sind Vertragsrecht; eine übersetzte Fassung
 * wäre eine zweite Vertragsgrundlage, und welche gilt, entscheidet dann
 * niemand. Die Datenschutzerklärung ist der Sonderfall: Art. 12 Abs. 1 DSGVO
 * verlangt die Pflichtinformation in verständlicher Sprache, sobald ein
 * englisches Formular personenbezogene Daten erhebt.
 *
 * WARUM DIE TEXTE ALS HTML-ZEICHENKETTEN DASTEHEN: So steht je Absatz genau
 * ein Satzpaar nebeneinander und nicht zweimal dieselbe Verschachtelung. Die
 * Zeichenketten sind Motor-Literale aus dieser Datei – nichts davon kommt aus
 * der Konfiguration oder aus einem Redaktionssystem, deshalb ist `set:html`
 * hier unbedenklich (anders als bei Feldbeschriftungen, siehe Formular.astro).
 */
import { site, brauchtEinwilligung, type Kategorie } from '../../content.config';

interface Props {
  sprache?: 'de' | 'en';
}
const { sprache = 'de' } = Astro.props;
const en = sprache === 'en';
/** Wählt zwischen deutscher und englischer Fassung. */
const w = (de: string, eng: string) => (en ? eng : de);

const r = site.rechtstexte;

/** Sobald Dienste aktiv sind, MUSS die Erklärung sie nennen (Rechtspflicht). */
const hatDienste = brauchtEinwilligung(site);

const KATEGORIE_TITEL: Record<string, { de: string; en: string }> = {
  funktional: { de: 'Komfort-Dienste', en: 'Convenience services' },
  statistik: { de: 'Statistik / Reichweitenmessung', en: 'Statistics / audience measurement' },
  marketing: { de: 'Marketing', en: 'Marketing' },
};

/** Dienste nach Kategorie gruppieren – so liest es sich wie eine Behörde es erwartet. */
const dienstNachKategorie = (['funktional', 'statistik', 'marketing'] as Kategorie[])
  .map((k) => [k, site.dienste.filter((d) => d.kategorie === k)] as const)
  .filter(([, liste]) => liste.length > 0);

/* ---------------------------------------------------------------------------
 *  WAS DIE SEITE WIRKLICH EINBETTET – aus dem Markup gelesen, nicht behauptet
 *
 *  Vorher gab es genau EINEN Absatz („Karte / Anfahrt"), gesteuert von einem
 *  Handschalter in der Config. Der Baustein `<Einbettung>` ist aber allgemein –
 *  er trägt Google Maps, ein Video oder einen Instagram-Beitrag. Bettete ein
 *  Klon ein Video ein, stand dazu KEIN Wort in der Erklärung; es gab nicht
 *  einmal einen Schalter dafür. Und der Schalter selbst ging schief: In einem
 *  Kundenprojekt war die 2-Klick-Karte zwanzig Minuten online, während die
 *  Erklärung wörtlich behauptete „Es wird keine Karte eingebettet".
 *
 *  Deshalb wird jetzt der Quelltext der Seiten durchsucht. Die Wahrheit steht
 *  damit nur noch an EINER Stelle: dort, wo die Einbettung wirklich steht.
 *  Das Prüf-Tor hält beides zusätzlich gegeneinander.
 * ------------------------------------------------------------------------ */
const seitenQuellen = import.meta.glob<string>('/src/**/*.astro', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const einbettungsAnbieter = [
  ...new Set(
    Object.entries(seitenQuellen)
      // Die Erklärung selbst und der Baustein zählen nicht als Einsatz.
      .filter(([pfad]) => !/DatenschutzInhalt\.astro$|Einbettung\.astro$/.test(pfad))
      .flatMap(([, quelle]) =>
        [...String(quelle).matchAll(/<Einbettung\b[^>]*?anbieter=["']([^"']+)["']/g)].map((m) => m[1]),
      ),
  ),
].sort();

/* Dienste, die Daten in ein Drittland geben – NAMENTLICH. Vorher entstand der
   USA-Absatz allein daraus, DASS überhaupt ein Dienst eingetragen war. Bei
   einem europäischen Werkzeug behauptete die Erklärung damit eine
   Übermittlung, die es gar nicht gibt – samt falscher Rechtsgrundlage. */
/* Ein Dienst OHNE `drittland`-Angabe taucht hier bewusst nirgends auf: Die
   Erklärung darf nichts behaupten, was niemand eingetragen hat. Dass die
   Angabe fehlt, meldet das Prüf-Tor (scripts/check.mjs) – dort gehört sie hin,
   nicht in eine Rechtsseite, die sie dann irgendwie formulieren müsste. */
const drittlandDienste = site.dienste.filter((d) => d.drittland && d.drittland !== 'keines');

/* GIBT ES ÜBERHAUPT EINE KARTE?
   Der Karten-Absatz stand ohne jede Bedingung da – jeder Klon ohne Anfahrt
   behauptete „Für die Anfahrt zeigen wir ein statisches Bild" und verwies auf
   einen Link, den es auf der Seite nicht gibt. Bei einer Praxis oder einer
   Kanzlei ohne Karte ist das schlicht eine falsche Aussage über die eigene
   Seite – dieselbe Klasse Fehler wie der Karten-Absatz, der einmal behauptete,
   es gebe KEINE Karte, während eine online war. */
const hatKarte = !!site.betrieb.adresse.karteBild;

/* DIE MERKLISTE HAENGT AM ATTRIBUT, NICHT AM KATALOG.
   Der Absatz stand unter `site.katalog` – ausgeloest wird der Baustein aber
   durch `data-merken="id"` im Markup. Ein Wirt kann Gerichte vormerken lassen,
   ein Studio Kurse, eine Galerie Bilder: alles ohne Katalog in der Config.
   Dann speichert die Seite etwas auf dem Geraet des Besuchers, und die
   Erklaerung schwieg dazu – waehrend sie zwei Absaetze weiter oben „keine
   Cookies" sagt. Gelesen wird deshalb wie beim Karten-Absatz aus dem MARKUP,
   nicht aus einem Schalter. Das Pruef-Tor haelt beides gegeneinander. */
/* WARUM DIE BEIDEN KATALOG-DATEIEN AUSGENOMMEN SIND – das ist kein Schönheits-
   fehler, sondern derselbe Fehler wie oben, nur andersherum. Der Quelltext-Scan
   findet `data-merken` in `KatalogListe.astro` und in der Katalog-Detailseite.
   Diese Dateien liegen in JEDEM Klon auf der Platte, auch bei einem Tischler,
   einer Praxis oder einem Wirt ohne Katalog – gebaut werden sie dort nie
   (`getStaticPaths` gibt ohne `katalog` eine leere Liste zurück, und die Liste
   wird nur von dieser einen Route eingebunden).

   Gemessen am 03.08.2026: Klon ohne Katalog gebaut → null Seiten mit
   `data-merken`, und die Datenschutzerklärung trug trotzdem den Absatz
   „Merkliste" mit dem Satz, der Browser speichere etwas auf dem Gerät. Das ist
   eine falsche Aussage über die eigene Seite in einer Rechtsseite – und sie
   stand so in jedem Klon.

   Ihre Bedingung ist `site.katalog`, und die steht bereits in der Zeile
   darunter. Der Scan bleibt für den Fall, für den er gebaut wurde: eigenes
   Markup im Klon (Gerichte vormerken, Kurse merken, Bilder sammeln). Dass
   beides zusammenpasst, hält das Prüf-Tor gegen den fertigen Build – seit
   heute in BEIDE Richtungen. */
const hatMerkliste =
  !!site.katalog ||
  Object.entries(seitenQuellen)
    .filter(([pfad]) => !/DatenschutzInhalt\.astro$|KatalogListe\.astro$|katalogEintrag\]\.astro$/.test(pfad))
    .some(([, quelle]) => /data-merken[=\s>]/.test(String(quelle)));
---

<p
  set:html={w(
    'Der Schutz Ihrer persönlichen Daten ist uns wichtig. Wir verarbeiten Ihre Daten ausschließlich auf Grundlage der gesetzlichen Bestimmungen (DSGVO, TKG 2021).',
    'Protecting your personal data matters to us. We process your data solely on the basis of the applicable law (GDPR, Austrian TKG 2021).',
  )}
/>

<h2>{w('Verantwortlicher', 'Controller')}</h2>
<address>
  <strong>{r.firmenwortlaut}</strong><br />
  {r.adresse}<br />
  {w('E-Mail: ', 'Email: ')}<a href={`mailto:${site.betrieb.email}`}>{site.betrieb.email}</a>
</address>

{/* Dieser Abschnitt richtet sich nach content.config.ts -> dienste.
    Ohne Dienste ist die Seite cookiefrei; sobald einer aktiv ist, wäre die
    Aussage „keine Cookies" falsch – und eine falsche Datenschutzerklärung
    ist ein echtes Rechtsrisiko. Deshalb schaltet der Text automatisch um. */}
{!hatDienste ? (
  <>
    <h2>{w('Keine Cookies, kein Tracking', 'No cookies, no tracking')}</h2>
    <p
      set:html={w(
        'Diese Website verwendet <strong>keine Cookies</strong>, kein Analyse-Werkzeug und keine Tracking-Skripte. Es werden keine Nutzungsprofile erstellt. Deshalb benötigt diese Seite auch keinen Cookie-Banner.',
        'This website uses <strong>no cookies</strong>, no analytics tool and no tracking scripts. No usage profiles are created. That is why this site needs no cookie banner.',
      )}
    />
  </>
) : (
  <>
    <h2>{w('Einwilligung, Cookies und externe Dienste', 'Consent, cookies and external services')}</h2>
    <p
      set:html={w(
        'Diese Website nutzt Dienste, die erst geladen werden, <strong>nachdem Sie zugestimmt haben</strong>. Ohne Ihre Einwilligung wird nichts davon geladen, es werden keine Daten an diese Anbieter übertragen und keine Cookies gesetzt (Art. 6 Abs. 1 lit. a DSGVO, § 165 Abs. 3 TKG 2021).',
        'This website uses services that are only loaded <strong>after you have consented</strong>. Without your consent nothing of this is loaded, no data is transferred to these providers and no cookies are set (Art. 6(1)(a) GDPR, § 165(3) TKG 2021).',
      )}
    />
    <p>
      <span
        set:html={w(
          'Ihre Entscheidung speichern wir lokal in Ihrem Browser (localStorage) – dabei werden keine Daten an uns übertragen. Gespeichert werden nur die von Ihnen freigegebenen Kategorien, der Zeitpunkt und eine Kennung der Dienste-Liste. Der Eintrag bleibt, bis Sie ihn selbst löschen <strong>oder wir die Liste der Dienste ändern – dann werden Sie automatisch erneut gefragt</strong>. Sie können Ihre Einwilligung jederzeit mit Wirkung für die Zukunft widerrufen:',
          'We store your decision locally in your browser (localStorage) – no data is transferred to us in the process. Only the categories you released, the time and an identifier of the service list are stored. The entry remains until you delete it yourself <strong>or we change the list of services – then you will automatically be asked again</strong>. You may withdraw your consent at any time with effect for the future:',
        )}
      />{' '}
      <button type="button" class="ds-widerruf" data-einwilligung-widerruf>
        {w('Einwilligung widerrufen', 'Withdraw consent')}
      </button>.
    </p>

    {dienstNachKategorie.map(([kategorie, liste]) => (
      <>
        <h3>{KATEGORIE_TITEL[kategorie]?.[sprache] ?? kategorie}</h3>
        <ul>
          {liste.map((d) => (
            <li>
              <strong>{d.name}</strong> – {w('Anbieter:', 'Provider:')} {d.anbieter}.<br />
              {w('Zweck:', 'Purpose:')} {d.zweck}.
              {d.setztCookies && <> {w('Dieser Dienst setzt Cookies.', 'This service sets cookies.')}</>}
              {' '}{w('Datenschutzerklärung des Anbieters:', "Provider's privacy policy:")}{' '}
              <a href={d.datenschutzUrl} target="_blank" rel="noopener noreferrer">{d.datenschutzUrl}</a>
            </li>
          ))}
        </ul>
      </>
    ))}

    {drittlandDienste.length > 0 && (
      <>
        <h3>{w('Übermittlung in Drittländer', 'Transfer to third countries')}</h3>
        <p>
          {w(
            'Bei den folgenden Diensten werden Daten außerhalb der EU verarbeitet:',
            'With the following services data is processed outside the EU:',
          )}
        </p>
        <ul>
          {drittlandDienste.map((d) => (
            <li>
              <strong>{d.name}</strong> ({d.anbieter}) – {d.drittland}
            </li>
          ))}
        </ul>
        <p>
          {w(
            /* DER ZWEITE SATZ WIDERSPRACH DER EIGENEN SEITE. Hier stand
               „Alle übrigen genannten Dienste verarbeiten ausschließlich
               innerhalb der EU" – während der Hosting-Absatz weiter unten den
               Hoster mit Sitz in den USA nennt und der Formular-Absatz den
               Versanddienst ebenso. Eine Erklärung, die sich auf derselben
               Seite selbst widerspricht, ist schlechter als eine knappe. */
            'Rechtsgrundlage ist Ihre Einwilligung (Art. 6 Abs. 1 lit. a, Art. 49 Abs. 1 lit. a DSGVO). Wo darüber hinaus Daten außerhalb der EU verarbeitet werden – etwa beim Hosting oder beim Versand von Formularanfragen –, ist das bei dem jeweiligen Dienst beschrieben und durch die Standardvertragsklauseln der Europäischen Kommission abgesichert.',
            'The legal basis is your consent (Art. 6(1)(a), Art. 49(1)(a) GDPR). Where data is processed outside the EU beyond this – for example for hosting or for sending form enquiries – this is described with the respective service and safeguarded by the European Commission’s standard contractual clauses.',
          )}
        </p>
      </>
    )}
  </>
)}

{/* Ein Absatz je TATSÄCHLICH eingebettetem Anbieter – siehe Kopf dieser
    Datei. Kein Handschalter mehr: Was im Markup steht, steht hier. */}
{einbettungsAnbieter.length > 0 ? (
  <>
    <h2>{w('Eingebettete Inhalte (Zwei-Klick-Lösung)', 'Embedded content (two-click solution)')}</h2>
    <p
      set:html={w(
        'An einzelnen Stellen binden wir Inhalte fremder Anbieter ein. Sie werden <strong>erst geladen, wenn Sie darauf klicken</strong> – vorher wird nichts übertragen. Der Klick ist Ihre Einwilligung für diesen Fall (Art. 6 Abs. 1 lit. a DSGVO).',
        'In a few places we embed content from third-party providers. It is <strong>only loaded once you click on it</strong> – nothing is transferred before that. The click is your consent for that individual case (Art. 6(1)(a) GDPR).',
      )}
    />
    <ul>
      {einbettungsAnbieter.map((anbieter) => (
        <li>
          <strong>{anbieter}</strong>{' '}
          <span
            set:html={w(
              '– beim Klick werden Ihre <strong>IP-Adresse</strong> und Angaben zu Ihrem Browser an diesen Anbieter übertragen. Es gelten dann zusätzlich dessen Datenschutzbestimmungen.',
              "– on clicking, your <strong>IP address</strong> and details about your browser are transferred to this provider. That provider's privacy terms then apply in addition.",
            )}
          />
        </li>
      ))}
    </ul>
    {hatKarte && (
      <p
        set:html={w(
          'Für die Anfahrt zeigen wir zusätzlich ein <strong>statisches Kartenbild</strong> (Kartendaten von OpenStreetMap, beim Erstellen der Seite eingebunden) – dabei wird nichts übertragen.',
          'For directions we additionally show a <strong>static map image</strong> (map data from OpenStreetMap, embedded when the page was built) – nothing is transferred in the process.',
        )}
      />
    )}
  </>
) : hatKarte ? (
  <>
    <h2>{w('Karte / Anfahrt', 'Map / directions')}</h2>
    <p
      set:html={w(
        'Für die Anfahrt zeigen wir ein <strong>statisches Bild</strong> (Kartendaten von OpenStreetMap, beim Erstellen der Seite eingebunden). Es wird keine Karte eingebettet, es werden also keine Daten übertragen, solange Sie nicht selbst auf einen Link zu einem Kartendienst klicken. Erst dann gelten dessen Datenschutzbestimmungen.',
        "For directions we show a <strong>static image</strong> (map data from OpenStreetMap, embedded when the page was built). No map is embedded, so no data is transferred unless you click a link to a map service yourself. Only then do that service's privacy terms apply.",
      )}
    />
  </>
) : null}

<h2>{w('Server-Logfiles (Hosting)', 'Server log files (hosting)')}</h2>
<p
  set:html={w(
    'Beim Aufruf der Website werden durch den Hosting-Anbieter automatisch technische Daten (z. B. IP-Adresse, Datum und Uhrzeit, aufgerufene Seite, Browsertyp) in sogenannten Server-Logfiles gespeichert. Diese Verarbeitung dient dem sicheren und stabilen Betrieb (Art. 6 Abs. 1 lit. f DSGVO). Die Daten werden nicht mit anderen Quellen zusammengeführt.',
    'When the website is accessed, the hosting provider automatically stores technical data (e.g. IP address, date and time, page requested, browser type) in what are called server log files. This processing serves secure and stable operation (Art. 6(1)(f) GDPR). The data is not combined with other sources.',
  )}
/>

{/* Die aufgezählten Daten kommen aus den ECHTEN Formularfeldern. Vorher stand
    hier eine feste Liste (Name, E-Mail, Telefon, Nachricht) – bei einem
    Reservierungsformular mit Datum, Uhrzeit und Personenzahl nannte die
    Erklärung also weniger Daten, als tatsächlich erhoben werden. */}
{site.formulare.length > 0 && (
  <>
    <h2>
      {site.formulare.length > 1 ? w('Formulare', 'Forms') : w('Kontaktformular', 'Contact form')}
    </h2>
    <p>
      <span
        set:html={
          site.formulare.length > 1
            ? w(
                'Wenn Sie uns über eines unserer Formulare schreiben, verarbeiten wir die von Ihnen angegebenen Daten, um Ihre Anfrage zu beantworten (Art. 6 Abs. 1 lit. b und f DSGVO). Der Versand an unser Postfach erfolgt über den Dienst <strong>Resend</strong>',
                'When you write to us using one of our forms, we process the data you provide in order to answer your enquiry (Art. 6(1)(b) and (f) GDPR). Delivery to our mailbox is handled by the service <strong>Resend</strong>',
              )
            : w(
                'Wenn Sie uns über das Kontaktformular schreiben, verarbeiten wir die von Ihnen angegebenen Daten, um Ihre Anfrage zu beantworten (Art. 6 Abs. 1 lit. b und f DSGVO). Der Versand an unser Postfach erfolgt über den Dienst <strong>Resend</strong>',
                'When you write to us using the contact form, we process the data you provide in order to answer your enquiry (Art. 6(1)(b) and (f) GDPR). Delivery to our mailbox is handled by the service <strong>Resend</strong>',
              )
        }
      />
      {/* HIER STAND EIN SCHALTER MIT ZWEI FASSUNGEN, und die EU-Fassung war
          sachlich falsch. Sie behauptete „die Verarbeitung findet in der
          Europäischen Union statt", sobald beim Versanddienst eine EU-Region
          gewählt war.

          Beim Anbieter nachgelesen (resend.com/security/gdpr, abgerufen am
          31.08.2026):

            „Resend stores customer data in the United States, including
             message content, delivery logs, webhook payloads, and account
             records. The region you select when adding a sending domain (for
             example, eu-west-1) controls where email is routed and sent from.
             It does not control where data is stored, and there is no setting
             today that moves stored data to the EU."

          Die Regionswahl bestimmt also nur, von WO AUS verschickt wird – nicht
          den Speicherort. Der volle Wortlaut jeder Anfrage liegt in den USA
          und ist im Konto des Anbieters einsehbar.

          Die EU-Fassung ist deshalb ersatzlos entfallen; es gibt nur noch die
          zutreffende. Ein Schalter, dessen eine Stellung immer falsch ist,
          gehört nicht abgeschwächt, sondern weg. Gefunden an einer laufenden
          Kundenseite, die diese Zusage wochenlang öffentlich gemacht hat. */}
      {w(
        ' (Resend, Inc., USA – abgesichert über die EU-Standardvertragsklauseln)',
        ' (Resend, Inc., USA – safeguarded by the EU standard contractual clauses)',
      )}
      {w(
        /* DER NACHSATZ ZU DEN AUFBEWAHRUNGSPFLICHTEN IST PFLICHT, nicht
           Beiwerk. Hier stand nur „nur so lange, wie es zur Bearbeitung
           erforderlich ist" – ein Versprechen, das kein Betrieb halten kann,
           sobald aus einer Anfrage ein Geschäft wird: Beim Wirt die Feier,
           beim Handwerker der Auftrag. Dann greifen handels- und
           steuerrechtliche Fristen, und die Website behauptet etwas anderes
           als das, was tatsächlich passiert. Der Satz stand in jedem Klon. */
        '. Wir geben Ihre Daten nicht ohne Ihre Einwilligung an weitere Dritte weiter. Nach Erledigung Ihrer Anfrage löschen wir sie, soweit uns keine gesetzliche Aufbewahrungspflicht zur weiteren Speicherung verpflichtet – etwa die handels- und steuerrechtlichen Fristen, wenn aus der Anfrage ein Geschäft geworden ist.',
        '. We do not pass your data on to further third parties without your consent. Once your enquiry has been dealt with we delete it, unless a statutory retention obligation requires us to keep it – for example commercial and tax law periods where the enquiry has led to a business transaction.',
      )}
    </p>
    {/* HIER STAND DER MAIL-BETREFF – also „Neue Anfrage über <domain>".
        Das ist die Innensicht des Betriebs, eine Zeile, die nie für
        Leserinnen gedacht war, und sie stand in JEDEM Klon, weil jeder Klon
        mindestens ein Formular hat. Bei mehreren Formularen war es zudem
        dreimal fast derselbe Betreff, also keine Unterscheidung.

        Bei EINEM Formular sagt die Überschrift darüber ohnehin alles –
        dann steht hier nur die Feldliste. */}
    {/* ZUSTIMMUNGS-HÄKCHEN GEHÖREN NICHT IN DIE DATEN-AUFZÄHLUNG.
        Ihre Beschriftung ist ein ganzer Satz. In der Liste stand dadurch
        „Name, E-Mail, Telefon, Nachricht, Ich habe die Datenschutzerklärung
        gelesen." – das liest sich wie eine erhobene Angabe und macht die
        Aufzählung unbrauchbar. Dass die Zustimmung festgehalten wird, sagt
        stattdessen der Satz darunter; er erscheint nur, wenn es wirklich ein
        Häkchen gibt. Beim Lesen von `pruefung/texte.md` aufgefallen – kein
        Tor misst, ob ein Rechtstext sich gut liest. */}
    <ul>
      {site.formulare.map((f) => (
        <li>
          {site.formulare.length > 1 && <strong>{f.bezeichnung ?? f.id}: </strong>}
          {f.felder
            .filter((feld) => feld.typ !== 'haekchen')
            .map((feld) => (en ? (feld.labelEn ?? feld.label) : feld.label))
            .join(', ')}
        </li>
      ))}
    </ul>
    {site.formulare.some((f) => f.felder.some((feld) => feld.typ === 'haekchen')) && (
      <p>
        {w(
          'Außerdem halten wir fest, welche Zustimmungen Sie im Formular gegeben haben – das ist der Nachweis Ihrer Einwilligung.',
          'We also record which consents you gave in the form – this is the record of your consent.',
        )}
      </p>
    )}

