---
/**
 * Formular – MOTOR-Baustein.
 *
 * Rendert die Felder aus content.config.ts -> formulare, hängt den Honeypot an,
 * setzt die Motor-Texte in der gewählten Ansprache und verdrahtet den
 * Datenschutz-Hinweis. Das AUSSEHEN kommt aus dem Design.
 *
 * IN DER VORSCHAU (demo) IST DAS FORMULAR SICHTBAR, ABER TOT.
 * Bis 2026-07-27 wurde in der Vorschau gar kein Formular gerendert, nur ein
 * grauer Hinweis. Das kostete an drei Stellen:
 *   – Der Kunde sah bei der Abnahme ausgerechnet dort nichts, wo seine
 *     Anfragen herkommen sollen.
 *   – Der Port schrieb das gesamte Formular-Aussehen BLIND; Sichtprüfung und
 *     Bedien-Prüfung bekamen es nie zu Gesicht.
 *   – Beim Umschalten auf live erschien plötzlich ein nie geprüftes
 *     Bedienelement – genau in dem Moment, in dem laut Ablauf „nur noch drei
 *     Dinge" zu tun sind und niemand mehr an der Technik arbeitet.
 * Jetzt: Felder sichtbar und bedienbar, Absenden gesperrt, Hinweis darüber.
 * Die Sperre ist strukturell, nicht kosmetisch – das Formular trägt in der
 * Vorschau `data-formular-vorschau` statt `data-formular` und hat KEIN
 * `action`. Ohne Ziel und ohne Versand-Baustein kann nichts hinausgehen,
 * auch nicht ohne JavaScript. Das Prüf-Tor kontrolliert genau das.
 *
 * Verwendung:  <Formular id="kontakt" />
 */
import { site } from '../../content.config';
import { motorTexte, motorBeschriftungen } from '../lib/texte';

interface Props {
  /** ID aus content.config.ts -> formulare */
  id: string;
  class?: string;
  /**
   * Worauf bezieht sich die Anfrage? Etwa der Titel eines Katalog-Eintrags.
   * Wird als verdecktes Feld mitgeschickt und steht so in der E-Mail –
   * der Interessent muss nicht abtippen, worum es geht.
   */
  bezug?: string;
  /** Sprache DIESER Seite – steuert die Motor-Beschriftungen. Standard 'de'. */
  sprache?: 'de' | 'en';
}
const { id, class: klasse, bezug, sprache = 'de' } = Astro.props;

const formular = site.formulare.find((f) => f.id === id);
if (!formular) {
  throw new Error(
    `Formular "${id}" gibt es nicht. Bekannt: ${site.formulare.map((f) => f.id).join(', ') || '(keine)'}. Ergänze es in content.config.ts -> formulare.`,
  );
}

const t = motorTexte(site.ansprache, sprache);
const b = motorBeschriftungen(sprache);
const istDemo = site.mode === 'demo';

/* Mehrstufig? Dann die Felder auf die Schritte verteilen. Ein Feld ohne
   `schritt` landet in Schritt 1 – so wird aus einem bestehenden Formular durch
   Ergänzen von `schritte` kein leerer erster Schritt. */
const schritte = formular.schritte ?? [];
const istAssistent = schritte.length > 1;
const gruppen = istAssistent
  ? schritte.map((titel, i) => ({
      titel,
      nr: i + 1,
      felder: formular.felder.filter((f) => (f.schritt ?? 1) === i + 1),
    }))
  : [{ titel: '', nr: 1, felder: formular.felder }];

/* `pattern` IGNORIERT DER BROWSER bei number/date/time – dort prüft er nach
   eigenen Regeln. Ein Muster, das dort steht, tut also nichts, und zwar ohne
   jede Meldung: Der Betrieb glaubt, das Format sei abgesichert, und bekommt
   Anfragen in jeder erdenklichen Schreibweise. Lieber beim Bauen anhalten. */
const musterFalsch = formular.felder.find(
  (f) => f.muster && (f.typ === 'zahl' || f.typ === 'datum' || f.typ === 'zeit'),
);
if (musterFalsch) {
  throw new Error(
    `Formular "${formular.id}", Feld "${musterFalsch.name}": \`muster\` wirkt bei typ '${musterFalsch.typ}' nicht – ` +
      'der Browser sieht es dort gar nicht an. Entweder `muster` entfernen, oder das Feld auf ' +
      "typ 'text' stellen (dann greift das Muster, aber die Eingabehilfe des Geräts fällt weg). " +
      'Bei Zahlen führen `min`/`max` zum Ziel.',
  );
}

// Ein leerer Schritt wäre eine Sackgasse – lieber beim Bauen auffallen.
const leer = gruppen.find((g) => g.felder.length === 0);
if (leer) {
  throw new Error(
    `Formular "${formular.id}": Schritt ${leer.nr} („${leer.titel}") hat kein einziges Feld. Setze bei den betreffenden Feldern in content.config.ts \`schritt: ${leer.nr}\`.`,
  );
}
---

{istDemo && (
  <div class:list={['formular-demo', klasse]} role="note" data-formular-demo>
    <strong>{b.vorschauTitel}</strong>
    <p>{t.formularDemo}</p>
  </div>
)}

{(
  <form
    class:list={['formular', klasse, istAssistent && 'formular--assistent', istDemo && 'formular--vorschau']}
    method="post"
    action={istDemo ? undefined : '/api/contact'}
    data-formular={istDemo ? undefined : ''}
    data-formular-vorschau={istDemo ? '' : undefined}
    data-formular-id={formular.id}
    data-assistent={istAssistent ? '' : undefined}
    data-text-sendet={t.sendet}
    data-text-erfolg={t.erfolg}
    data-text-fehler={t.fehler}
    data-text-verbindungsfehler={t.verbindungsfehler}
    data-text-vorschau={t.formularDemo}
  >
    <input type="hidden" name="formular" value={formular.id} />
    {/* DAS ZIEL FÜR `data-dialog-bezug` – IMMER GERENDERT, nicht nur wenn
        beim Bauen schon ein Bezug feststeht.

        Der Dialog-Baustein füllt zur Laufzeit `[data-dialog-bezug-ziel]`, damit
        EIN Anfrage-Fenster für viele Katalog-Einträge reicht („Anfrage zu
        <Eintrag>"). CLAUDE.md Abschnitt 5 führt genau das als Zweck des
        Bausteins. Es gab dieses Ziel aber nie: Das Feld entstand nur, wenn die
        Komponente schon beim Bauen einen `bezug` bekam – bei einem Dialog steht
        der aber erst beim Klick fest. Die Anfrage ging dann ohne jeden Hinweis
        raus, um welchen Eintrag es geht, und der Betrieb musste zurückfragen. */}
    <input type="hidden" name="bezug" value={bezug ?? ''} data-dialog-bezug-ziel />
    {bezug && (
      /* Sichtbar für den Absender, wenn der Bezug schon feststeht – sonst
         bestätigt er eine Anfrage, deren Gegenstand er nicht sieht. */
      <p class="formular__bezug" data-formular-bezug>{bezug}</p>
    )}

    {istAssistent && (
      <div class="formular__fortschritt">
        {/* Sichtbar UND vorgelesen: Ohne die Angabe weiß niemand, wie lange
            es noch dauert – und genau das entscheidet über das Abbrechen. */}
        <p class="formular__schrittzahl" data-assistent-fortschritt aria-live="polite"></p>
        <div class="formular__balken" data-assistent-balken aria-hidden="true"></div>
        <ol class="formular__punkte">
          {gruppen.map((g) => (
            <li class="formular__punkt" data-assistent-punkt={g.nr}>{g.titel}</li>
          ))}
        </ol>
      </div>
    )}

    {gruppen.map((gruppe) => (
      <fieldset
        class="formular__schritt"
        data-assistent-schritt={istAssistent ? gruppe.nr : undefined}
      >
        {istAssistent && <legend class="formular__schritt-titel">{gruppe.titel}</legend>}

        {gruppe.felder.map((f) => (
          <label class="formular__feld" data-feld={f.name} data-typ={f.typ}>
            <span class="formular__label">
              {sprache === 'en' ? (f.labelEn ?? f.label) : f.label}
              {/* DER MOTOR KENNZEICHNET DIE FREIWILLIGEN FELDER, NICHT DIE
                  PFLICHTFELDER. Das ist eine UMKEHR-Konvention, und wer sie
                  nicht kennt, baut zwei Konventionen in ein Formular:

                  Sobald ALLE Felder Pflicht sind, steht hier gar nichts mehr –
                  und ein Sternchen, das jemand „zur Sicherheit" ergänzt, sagt
                  dann dasselbe wie das Fehlen von „(optional)". Der Besucher
                  sieht zwei Systeme nebeneinander.

                  Wer trotzdem Sternchen will (das Design verlangt es
                  gelegentlich), beachtet drei Dinge:
                  1. Sternchen mit `aria-hidden` – Screenreader sagen das
                     `required` am Feld ohnehin an, sonst hört man es doppelt.
                  2. Die Farbe gehört in die Design-Datei des Klons, nicht in
                     diese Motor-Komponente.
                  3. Beim Umstellen freiwillig -> Pflicht den PLATZHALTERTEXT
                     mitprüfen: In einem Klon stand dort noch „optional",
                     während das Feld längst Pflicht war.

                  Das Leerzeichen ausdrücklich setzen: Zwischen zwei Ausdrücken
                  fällt der Zeilenumbruch weg, und auf der Seite stand
                  „Telefon(optional)". */}
              {!f.pflicht && <> <em class="formular__optional">{b.optional}</em></>}
            </span>

            {f.typ === 'textarea' ? (
              <textarea
                name={f.name}
                rows="5"
                required={f.pflicht}
                placeholder={f.platzhalter}
              />
            ) : f.typ === 'auswahl' ? (
              <select name={f.name} required={f.pflicht}>
                <option value="">{b.bitteWaehlen}</option>
                {(f.optionen ?? []).map((o) => <option value={o}>{o}</option>)}
              </select>
            ) : f.typ === 'haekchen' ? (
              /* Einzelnes Ankreuzfeld – typisch die Datenschutz-Zustimmung.
                 Der Wert landet als „ja"/„–" in der E-Mail. */
              <input type="checkbox" name={f.name} value="ja" required={f.pflicht} class="formular__haekchen" />
            ) : f.typ === 'mehrfach' ? (
              /* Mehrfachauswahl: mehrere Kästchen mit demselben Feldnamen.
                 Der Browser sendet sie als wiederholten Schlüssel; der
                 Formular-Baustein fasst sie zu „A, B" zusammen. */
              <span class="formular__mehrfach" role="group" aria-label={sprache === 'en' ? (f.labelEn ?? f.label) : f.label}>
                {(f.optionen ?? []).map((o) => (
                  <label class="formular__mehrfach-option">
                    <input type="checkbox" name={f.name} value={o} />
                    <span>{o}</span>
                  </label>
                ))}
              </span>
            ) : (
              /* `inputmode`: Ohne die Angabe geht am Handy die
                 BUCHSTABENtastatur auf, auch bei einem reinen Zahlenfeld.
                 Bewusst NICHT aus `f.typ` abgeleitet – ein Feld im Format
                 „MM / JJJJ" braucht den Schrägstrich, den die Zifferntastatur
                 nicht hat; es wäre dann nicht mehr ausfüllbar.
                 Und dieser Kommentar steht VOR dem Element: Ein geschweifter
                 JSX-Kommentar zwischen Attributen bricht die Typprüfung. */
              <input
                type={
                  f.typ === 'datum' ? 'date'
                  : f.typ === 'zeit' ? 'time'
                  : f.typ === 'zahl' ? 'number'
                  : f.typ
                }
                name={f.name}
                required={f.pflicht}
                autocomplete={f.autocomplete}
                inputmode={f.tastatur === 'dezimal' ? 'decimal' : f.tastatur === 'tel' ? 'tel' : undefined}
                pattern={f.typ === 'zahl' || f.typ === 'datum' || f.typ === 'zeit' ? undefined : f.muster}
                placeholder={f.platzhalter}
                min={f.typ === 'datum' && f.minDatum === 'heute' ? new Date().toISOString().slice(0, 10) : (f.minDatum ?? f.min)}
                max={f.max}
              />
            )}
          </label>
        ))}
      </fieldset>
    ))}

    {/* Zeitfalle gegen Spam: wird per JS mit der Ladezeit befüllt. Absenden
        unter 3 Sekunden = Bot (Menschen tippen länger). Ohne JS bleibt das
        Feld leer und die Prüfung entfällt – der Honeypot greift trotzdem. */}
    <input type="hidden" name="_t" value="" data-formular-zeit />

    {/* Honeypot gegen Spam: für Menschen unsichtbar, für Bots verlockend. */}
    <div class="formular__honeypot" aria-hidden="true">
      <label>
        {b.honeypot}
        <input type="text" name="webseite" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    {istAssistent && (
      <div class="formular__navigation">
        <button type="button" class="formular__zurueck" data-assistent-zurueck hidden>{b.zurueck}</button>
        <button type="button" class="formular__weiter" data-assistent-weiter>{b.weiter}</button>
      </div>
    )}

    <button type="submit" class="formular__absenden" data-formular-absenden>
      {b.senden}
    </button>

    <p class="formular__status" role="status" aria-live="polite" data-formular-status></p>

    <p class="formular__hinweis">
      {t.einwilligung}<a href={b.datenschutzPfad}>{b.datenschutz}</a>.
    </p>
  </form>
)}

<style>
  /* Nur das Nötigste – alles Weitere gestaltet das Design.
     Der Honeypot MUSS unsichtbar bleiben, sonst füllen ihn echte Menschen aus. */
  .formular__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .formular__feld {
    display: grid;
  }
  .formular__optional {
    font-style: normal;
  }

  /* Der <fieldset> bringt vom Browser einen Rahmen und Innenabstand mit, die
     jedes Design sonst erst wegräumen müsste. */
  .formular__schritt {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--raum-s, 1rem);
  }

  /* Ohne JavaScript stehen alle Schritte untereinander – dann sind die
     Weiter-/Zurück-Knöpfe sinnlos und die Schrittzahl irreführend. Das Skript
     setzt die Klasse `hat-js` auf <html>. */
  html:not(.hat-js) .formular__navigation,
  html:not(.hat-js) .formular__fortschritt {
    display: none;
  }

  .formular__punkte {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-xs, 0.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Nur die Mechanik: ein Balken, dessen Breite der Assistent setzt.
     Farbe, Höhe und Rundung bestimmt das Design. */
  .formular__balken::before {
    content: '';
    display: block;
    width: var(--fortschritt, 0%);
    height: 100%;
    transition: width 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .formular__balken::before { transition: none; }
  }

  .formular__navigation {
    display: flex;
    gap: var(--raum-xs, 0.75rem);
    flex-wrap: wrap;
  }
</style>
