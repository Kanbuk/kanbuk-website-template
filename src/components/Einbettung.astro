---
/**
 * Einbettung – MOTOR-Baustein: 2-Klick-Lösung für externe Rahmen.
 *
 * Für Kunden, die unbedingt eine bediente Google-Karte, ein YouTube-Video oder
 * einen Instagram-Beitrag wollen. Der <iframe> steht NICHT im HTML – er entsteht
 * erst beim Klick. Bis dahin geht kein Byte an den fremden Anbieter.
 *
 * Damit bleibt die Seite ohne Einwilligungs-Banner zulässig: Der Klick IST die
 * Einwilligung für diesen einen Fall.
 *
 * BESSER für die Anfahrt: `npm run karte` – ein statisches Bild mit Link.
 * Kein Rahmen, kein Klick, keine Diskussion. Diese Komponente ist die Ausnahme.
 *
 * Verwendung:
 *   <Einbettung
 *     url="https://www.google.com/maps/embed?pb=…"
 *     titel="Karte: Musterstraße 1"
 *     anbieter="Google Maps"
 *   >
 *     <Image src={karte} alt="Karte" />   <!-- Platzhalter (optional) -->
 *   </Einbettung>
 *   <p data-einbettung-nur-platzhalter>Kartendaten © OpenStreetMap-Mitwirkende</p>
 *
 * `data-einbettung-anbieter` steht im Markup, damit die Datenschutzerklärung
 * den Anbieter benennen kann UND das Prüf-Tor beides gegeneinander hält.
 * Vorher lebte diese Angabe nur in einer Eigenschaft und war nach dem Bauen
 * verschwunden.
 *
 * Alles mit `data-einbettung-nur-platzhalter` im selben Abschnitt verschwindet,
 * sobald der echte Rahmen geladen ist – gedacht für die Lizenzzeile des
 * statischen Kartenbildes, die über die dann sichtbare Google-Karte nichts
 * mehr aussagt.
 */
import { site } from '../../content.config';

interface Props {
  /** Die Embed-Adresse des Anbieters. */
  url: string;
  /** Titel des Rahmens – Pflicht für Screenreader. */
  titel: string;
  /** Anbietername, erscheint im Hinweis („… lädt Inhalte von Google Maps"). */
  anbieter: string;
  /** Seitenverhältnis, z. B. "16 / 9" (Video) oder "4 / 3" (Karte). */
  format?: string;
  /** Einwilligungs-Kategorie. Standard: funktional. */
  kategorie?: 'funktional' | 'statistik' | 'marketing';
  /**
   * Lädt von selbst, sobald die Kategorie freigegeben ist – auch nachträglich,
   * wenn der Besucher im Banner auf „Alle akzeptieren" klickt.
   *
   * STANDARD AUS, und das ist Absicht: Der Klick auf den Platzhalter IST die
   * Einwilligung für diesen einen Fall (CLAUDE.md 7a). Wer `auto` setzt,
   * entscheidet bewusst, dass die allgemeine Zustimmung genügt.
   *
   * Ohne diese Eigenschaft gab es das Attribut `data-einbettung-auto`
   * nirgends – der Baustein hat zwei Zweige dafür, und beide waren toter Code.
   */
  auto?: boolean;
  class?: string;
}

const {
  url,
  titel,
  anbieter,
  format = '16 / 9',
  kategorie = 'funktional',
  auto = false,
  class: klasse,
} = Astro.props;

const t =
  site.ansprache === 'du'
    ? {
        hinweis: `Beim Laden werden Daten an ${anbieter} übertragen – auch deine IP-Adresse.`,
        knopf: `${anbieter} laden`,
        dauerhaft: 'Erst nach deinem Klick. Vorher wird nichts übertragen.',
      }
    : {
        hinweis: `Beim Laden werden Daten an ${anbieter} übertragen – auch Ihre IP-Adresse.`,
        knopf: `${anbieter} laden`,
        dauerhaft: 'Erst nach Ihrem Klick. Vorher wird nichts übertragen.',
      };
---

<div
  class:list={['einbettung', klasse]}
  data-einbettung={url}
  data-einbettung-titel={titel}
  data-einbettung-anbieter={anbieter}
  data-einbettung-kategorie={kategorie}
  data-einbettung-format={format}
  data-einbettung-auto={auto ? '' : undefined}
  style={`aspect-ratio: ${format};`}
>
  <div class="einbettung__platzhalter">
    {/* Optionaler Platzhalter (z. B. das statische Kartenbild) */}
    <slot />
    <div class="einbettung__hinweis">
      <p class="einbettung__text">{t.hinweis}</p>
      <button type="button" class="einbettung__knopf" data-einbettung-laden>{t.knopf}</button>
      <p class="einbettung__klein">{t.dauerhaft}</p>
    </div>
  </div>
</div>

<style>
  /* Nur das Nötigste, damit der Platzhalter benutzbar ist – Rest macht das Design. */
  .einbettung {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    /* MINDESTHÖHE, WEIL `aspect-ratio` ERST AB SAFARI 15 GILT.
       Die Höhe dieser Box kommt allein aus dem `aspect-ratio` im style-Attribut
       darüber. Darunter ist sie 0 px hoch – und weil der Platzhalter absolut
       darin liegt, verschwindet mit ihr ALLES: das Kartenbild, der Hinweis und
       der Knopf zum Laden. Ein Besucher sieht dann eine leere Stelle und hat
       keinen Weg zur Karte. Das ist Bedienbarkeit, nicht Aussehen – und damit
       auch unterhalb der Zusage abzusichern (CLAUDE.md 4a).
       Kein var() in dieser Zeile, sonst greift der Ersatzwert nicht. */
    min-height: 10rem;
  }
  .einbettung__platzhalter {
    position: absolute;
    /* `inset` gibt es erst ab Safari 14.1 – die vier Einzelangaben kennt jeder
       Browser. Sie enthalten kein var(), werden also wirklich behalten. */
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    inset: 0;
  }
  .einbettung__platzhalter :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .einbettung__hinweis {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--raum-2xs);
    padding: var(--raum-s);
    text-align: center;
    /* Fast deckend, damit der Hinweistext auf dem Kartenbild lesbar bleibt.
       Gerechnet statt gemischt: Der Motor benutzt bewusst nirgends `color-mix()`
       – ein Ersatzwert davor wirkt NICHT, wenn die moderne Zeile ein `var()`
       enthält. Begründung samt Messung in src/lib/theme.ts. */
    background: var(--farbe-grund-82);
    backdrop-filter: blur(2px);
  }
  .einbettung__text {
    font-size: var(--schrift-s);
    max-width: 44ch;
  }
  /* Mindestens 44×44 px: Das ist die empfohlene Fingerfläche am Handy –
     darunter tippt man daneben. Gemessener Ausgangswert im Piloten: 36 px hoch. */
  .einbettung__knopf {
    min-height: 44px;
    padding: var(--raum-2xs) var(--raum-s);
    border: 1px solid var(--farbe-primaer);
    border-radius: var(--radius);
    font-weight: 600;
  }
  .einbettung__klein {
    font-size: var(--schrift-xs);
    opacity: 0.75;
  }
  /* Nach dem Laden ersetzt das Skript den Inhalt durch den <iframe>. */
  .einbettung.ist-geladen {
    aspect-ratio: auto;
  }
</style>
