---
/**
 * Fuss – MOTOR-Baustein: die Fußzeile für den Fall, dass das Design SCHWEIGT.
 *
 * ==========================================================================
 * ZUERST LESEN: Zeigt das Design eine eigene Fußzeile, wird SIE gebaut.
 * ==========================================================================
 * Dieser Baustein ist der Rückfall, nicht die Vorgabe. Er stellt die
 * Pflichtteile in einer sinnvollen Reihenfolge zusammen – mehr nicht.
 *
 * Hat das Design eine eigene Fußzeile (vier Spalten, Öffnungszeiten, Karte,
 * was auch immer), dann wird sie nachgebaut und die Pflichtteile werden
 * einzeln hineingestellt:
 *
 *     <footer class="…">           <!-- die Fußzeile des DESIGNS -->
 *       …Spalten des Designs…
 *       <Rechtslinks class="…" />  <!-- dorthin, wo das Design sie zeigt -->
 *       <Signatur />
 *     </footer>
 *
 * WARUM DAS HIER SO DEUTLICH STEHT: Bis 05.08.2026 steckten Copyright,
 * Social-Icons, Rechtslinks und Signatur fest in einer unveränderlichen
 * unteren Zeile; dem Design blieb nur ein Slot DARÜBER. Wer sie woanders
 * brauchte, musste die Fußzeile selbst schreiben und die Pflichtteile dabei
 * von Hand nachziehen. Beim zweiten Port ging genau das schief: In der
 * Fußzeile stand noch einmal das Kopf-Menü, während das Design dort das
 * Rechts-Menü vorsah. Der Betrieb fand es bei der Abnahme.
 *
 * Das Netz dahinter: Fehlen Impressum oder Datenschutz, blockt das Prüf-Tor
 * JEDE Seite. Eigenbau ist deshalb ungefährlich.
 *
 * Verwendung:  <Fuss />           oder mit eigenem Inhalt darüber:
 *              <Fuss><div class="…">…</div></Fuss>
 */
import { site } from '../../content.config';
import SocialLinks from './SocialLinks.astro';
import Signatur from './Signatur.astro';
import Rechtslinks from './Rechtslinks.astro';

interface Props {
  class?: string;
}
const { class: klasse, ...rest } = Astro.props;

const jahr = new Date().getFullYear();
const rechtsname = site.rechtstexte?.firmenwortlaut || site.betrieb.name;
---

<footer class:list={['fuss', klasse]} {...rest}>
  <div class="container">
    <slot />

    <div class="fuss__unten">
      <p class="fuss__recht-inhaber">© {jahr} {rechtsname}</p>
      <SocialLinks />
      <Rechtslinks />
      <Signatur />
    </div>
  </div>
</footer>

<style>
  .fuss {
    border-top: 1px solid var(--farbe-linie);
    padding-block: var(--raum-l) var(--raum-m);
    font-size: var(--schrift-s);
  }
  .fuss__unten {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--raum-2xs) var(--raum-m);
  }
  /* Die Anordnung der Rechtslinks stand hier – und wirkte nie: Astro grenzt
     Stile ab, das <nav> gehört einer anderen Datei, die Regel fand nichts.
     In der Fußzeile stand deshalb „ImpressumDatenschutz". Der Baustein bringt
     seine Anordnung jetzt selbst mit; die Begründung steht in seinem Kopf. */
  .fuss__recht-inhaber {
    margin: 0;
  }
</style>
