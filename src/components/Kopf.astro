---
/**
 * Kopf – MOTOR-Baustein: die Kopfleiste mit Marke und Navigation.
 *
 * WARUM ES DEN BAUSTEIN GIBT: Bis 2026-07-27 baute jeder Klon Kopf und Fuß von
 * Hand nach – rund 150 Zeilen pro Kunde, jedes Mal neu, jedes Mal ungeprüft.
 * Das war der größte wiederkehrende Block im Port und zugleich die Stelle, an
 * der ein vergessener Rechtslink oder eine fehlende Handy-Navigation entsteht.
 *
 * Der Baustein liefert die MECHANIK: klebende Leiste, Marke (Logo oder Name),
 * Navigation samt funktionierendem Handy-Menü, `--kopf-hoehe` für Sprungmarken.
 * Das Design malt an – jede Klasse ist per `:global(.kopf…)` überschreibbar,
 * und wer eine völlig andere Leiste braucht, baut sie weiterhin selbst.
 *
 * Verwendung:  <Kopf aktuell={pfad} />
 */
import { Image } from 'astro:assets';
import { site } from '../../content.config';
import { bild } from '../lib/bilder';
import Navigation from './Navigation.astro';

interface Props {
  /** Aktueller Pfad – für den aktiven Navigationspunkt. */
  aktuell?: string;
  class?: string;
}
const { aktuell = '/', class: klasse, ...rest } = Astro.props;

const logo = site.betrieb.logo ? bild(site.betrieb.logo) : null;
---

<header class:list={['kopf', klasse]} {...rest}>
  <div class="container kopf__inner">
    <a class="kopf__marke" href="/" aria-label={`${site.betrieb.name} – zur Startseite`}>
      {logo ? (
        <Image src={logo} alt={site.betrieb.name} height={36} densities={[1, 2]} class="kopf__logo" />
      ) : (
        <span class="kopf__name">{site.betrieb.name}</span>
      )}
    </a>
    <Navigation aktuell={aktuell} />
  </div>
</header>

{/* DIE HÖHE DER LEISTE MISST SICH SELBST.
    ==========================================================================
    `global.css` rechnet `scroll-padding-top` aus `--kopf-hoehe` – und dieser
    Dateikopf sagte zu, den Wert zu liefern. **Er wurde nirgends gesetzt.**
    Beide Seiten verließen sich auf die andere; der Rückfall ist `0px`.

    Die Folge ist unauffällig und trifft jede Seite: Wer mit der Tastatur
    „Zum Inhalt" springt oder einen Anker anklickt, landet um die Leistenhöhe
    zu hoch – die Überschrift steckt hinter der klebenden Leiste. Kein Tor
    sieht das: Es läuft nichts über, nichts ist abgeschnitten, der Kontrast
    stimmt.

    Warum gemessen und nicht geschrieben: Die Höhe gehört dem Design (Logo,
    Innenabstand, Schriftgröße, am Handy anders als am Bildschirm). Eine feste
    Zahl im Motor wäre bei jedem zweiten Kunden falsch. Gemessen stimmt sie
    immer – auch wenn das Design die Leiste beim Scrollen schrumpfen lässt.

    Ohne JavaScript bleibt es beim alten Verhalten (Rückfall `0px`). Das ist
    richtig: Ein Sprung, der etwas zu hoch landet, ist ein Schönheitsfehler –
    eine Leiste, die ohne JS gar keinen Platz mehr bekäme, wäre einer nicht.

    Schreibweise nach CLAUDE.md 4a: kein Zerlegen in Klammern, sonst ist das
    GESAMTE Skriptbündel für ältere Browser ein Lesefehler. */}
<script is:inline>
  (function () {
    var leiste = document.currentScript && document.currentScript.previousElementSibling;
    if (!leiste || leiste.tagName !== 'HEADER') leiste = document.querySelector('header.kopf');
    if (!leiste) return;
    function messen() {
      var hoehe = Math.round(leiste.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--kopf-hoehe', hoehe + 'px');
    }
    messen();
    if (typeof ResizeObserver === 'function') {
      new ResizeObserver(messen).observe(leiste);
    } else {
      window.addEventListener('resize', messen);
    }
    /* Schriften kommen später an und ändern die Höhe noch einmal. */
    if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
      document.fonts.ready.then(messen);
    }
  })();
</script>

<style>
  .kopf {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Fast deckend: Sonst schiebt sich der Inhalt beim Scrollen sichtbar
       hinter der Kopfleiste durch. */
    background: var(--farbe-grund-92);
    /* Die -webkit-Schreibweise ist Pflicht, nicht Zierde: Safari kennt
       `backdrop-filter` ohne Präfix erst ab 18, die Zusage des Motors liegt
       bei 15.4 (browser-untergrenze.json). Ohne sie fehlt auf jedem iPhone
       zwischen diesen Ständen das Milchglas – und weil der Grund nur zu 92 %
       deckt, schiebt sich der Inhalt beim Scrollen sichtbar durch.
       Das fünfte Tor sieht das nicht: Es prüft CSS gegen eine benannte Liste,
       und eine fehlende Herstellerschreibweise steht dort nicht drin. */
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--farbe-linie);
  }
  .kopf__inner {
    /* position: relative ist PFLICHT – das Handy-Panel hängt sich mit
       `top: 100%` daran. Ohne das klappt es am oberen Seitenrand auf. */
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--raum-s);
    padding-block: var(--raum-xs);
  }
  .kopf__marke {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: inherit;
  }
  .kopf__logo {
    height: 36px;
    width: auto;
    display: block;
  }
  .kopf__name {
    font-family: var(--font-ueberschrift);
    font-size: var(--schrift-l);
    /* Ein langer Betriebsname darf die Leiste nicht sprengen. */
    overflow-wrap: anywhere;
  }
</style>
