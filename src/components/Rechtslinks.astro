---
/**
 * Rechtslinks – Impressum, Datenschutz und (falls vorhanden) AGB.
 *
 * WARUM DAS EIN EIGENER BAUSTEIN IST
 * ==========================================================================
 * Diese drei Links steckten fest in `<Fuss>`, in einer unveränderlichen
 * unteren Zeile. Ein Design mit vierspaltiger Fußzeile, das sie in Spalte 3
 * haben will, konnte das nicht bauen – der Port musste die Fußzeile selbst
 * schreiben und die Links dabei von Hand nachziehen.
 *
 * Genau daraus entstand beim zweiten Port ein Fehler, den der Betrieb bei der
 * Abnahme fand: In der Fußzeile stand noch einmal das KOPF-Menü, während das
 * Design dort das Rechts-Menü vorsah. Der Baustein konnte es nicht liefern,
 * also entstand etwas anderes.
 *
 * Jetzt ist er einzeln zu haben und lässt sich hinstellen, wo das Design ihn
 * zeigt:
 *
 *     <Rechtslinks />                        <!-- irgendwo in der Design-Fußzeile -->
 *     <Rechtslinks class="spalte__liste" />  <!-- vom Design angemalt -->
 *
 * DAS NETZ DAHINTER: Fehlen die Links, blockt das Prüf-Tor JEDE Seite –
 * die Rechtsseiten müssen von überall erreichbar sein. Zerlegen ist deshalb
 * ungefährlich: Wer sie vergisst, kommt nicht durch.
 *
 * WAS DER MOTOR HIER BESTIMMT und das Design nicht: dass der AGB-Link nur
 * erscheint, wenn es die Seite wirklich gibt (sonst ein toter Link auf JEDER
 * Seite), und die 44-Pixel-Fingerfläche. Beides ist Technik, kein Aussehen.
 */
import { site } from '../../content.config';

interface Props {
  class?: string;
  /** Vorlesbare Bezeichnung der Gruppe. Auf Englisch überschreiben. */
  label?: string;
}
const { class: klasse, label = 'Rechtliches' } = Astro.props;

/* Der AGB-Link erscheint nur, wenn es die Seite wirklich gibt. Ein Link auf
   eine nicht gebaute Adresse wäre ein toter Link in JEDER Fußzeile – und damit
   auf jeder einzelnen Seite der Website. */
const hatAgb = (site.rechtstexte?.agb ?? []).length > 0;
---

<nav class:list={['rechtslinks', klasse]} aria-label={label}>
  <a href="/impressum">Impressum</a>
  <a href="/datenschutz">Datenschutz</a>
  {hatAgb && <a href="/agb">AGB</a>}
</nav>

<style>
  /* Nur die Fingerfläche – Abstände, Richtung und Farbe bestimmt das Design.
     Vorher standen hier zusätzlich `display: flex` und ein fester Abstand;
     das ist Gestaltung und gehört nicht dem Motor. Ein Design, das die Links
     untereinander stellen will, musste sie sonst erst zurückbiegen. */
  .rechtslinks a {
    /* 44px Fingerfläche – die Rechtslinks sind am Handy sonst kaum zu treffen. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
