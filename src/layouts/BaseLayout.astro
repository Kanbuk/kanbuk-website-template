---
/**
 * BaseLayout – das Grundgerüst jeder Seite. HIER sitzt der halbe Motor.
 *
 * Leistet je Seite:
 *  - eigener Titel, eigene Description, eigene Canonical, eigenes OG-Bild
 *  - Design-Tokens als CSS-Variablen (Nahtstelle zum Design)
 *  - JSON-LD LocalBusiness inkl. maschinenlesbarer Öffnungszeiten
 *  - hreflang, wenn mehrsprachig
 *  - demo-Modus: noindex (Meta; der HTTP-Header kommt über _headers/vercel.json)
 *  - startet die Verhaltens-Bausteine
 *
 * Das AUSSEHEN kommt aus dem Design – hier steht bewusst kein Layout.
 */
import '../styles/fonts.css';
import '../styles/global.css';
// Rohtext der Schriften-Deklarationen – fürs Vorladen unten ausgewertet.
import fontsCssRoh from '../styles/fonts.css?raw';
import { site, jsonLdTyp } from '../../content.config';
import { cssVariablen } from '../lib/theme';
import DemoBar from '../components/DemoBar.astro';
import Einwilligung from '../components/Einwilligung.astro';

interface Props {
  /** Pfad dieser Seite, z. B. '/speisekarte'. Muss in config.seiten stehen. */
  pfad?: string;
  /** Überschreibt den Titel aus der Seiten-Config (selten nötig). */
  titel?: string;
  /** Überschreibt die Description aus der Seiten-Config. */
  beschreibung?: string;
  /**
   * Diese Seite bewusst nicht in Google zeigen (z. B. Danke-Seite).
   * Im demo-Modus ist ohnehin alles gesperrt – das hier wirkt zusätzlich live.
   */
  noindex?: boolean;
  /**
   * Sprache DIESER Seite. Standard 'de'.
   *
   * WARUM ES DAS BRAUCHT: Ohne die Angabe war der dokumentierte Mehrsprachen-
   * Weg eine Sackgasse. Eine Seite unter /en/… hätte sich per `lang="de-AT"`
   * als deutsch ausgewiesen UND per canonical auf die deutsche Fassung
   * gezeigt – Google entfernt eine so ausgezeichnete Seite aus dem Index und
   * ignoriert wegen des Widerspruchs die hreflang-Angaben gleich mit. Die
   * englische Version hätte also nie ranken können.
   *
   * Eine englische Seite ruft auf:
   *   <BaseLayout pfad="/kontakt" sprache="en" titel="Contact" beschreibung="…">
   * `pfad` bleibt dabei der DEUTSCHE Pfad – daraus entstehen Adresse und
   * hreflang automatisch.
   */
  sprache?: 'de' | 'en';
  /**
   * Eigenes Vorschaubild fuer DIESE Seite als fertige Adresse (z. B. das Bild
   * eines Katalog-Eintrags). Muss 1200x630 sein - die Masse stehen als
   * og:image:width/height im Kopf und duerfen nicht luegen. Erzeugen mit
   * `getImage({ src, width: 1200, height: 630, fit: 'cover' })`.
   * Weglassen = Seiten- bzw. globales OG-Bild.
   */
  ogBildUrl?: string;
  /** Alt-Text zum eigenen Vorschaubild. */
  ogBildAlt?: string;
  /**
   * Zusaetzliche strukturierte Daten fuer Google, z. B. das Produkt-Schema
   * einer Katalog-Detailseite. Wird als eigener JSON-LD-Block ausgegeben.
   */
  zusatzLd?: Record<string, unknown>;
}

const {
  pfad = '/',
  titel,
  beschreibung,
  noindex = false,
  sprache = 'de',
  ogBildUrl,
  ogBildAlt,
  zusatzLd,
} = Astro.props;

const seite = site.seiten.find((s) => s.pfad === pfad);
if (!seite && !titel) {
  throw new Error(
    `Seite "${pfad}" fehlt in content.config.ts -> seiten. Ohne Eintrag gibt es keine Meta-Angaben (Titel, Description) – das lässt "npm run check" nicht durch.`,
  );
}

const istDemo = site.mode === 'demo';

const seitenTitel = titel ?? seite!.metaTitel;
/* Die Startseite trägt normalerweise „Name – Claim" statt „Seite | Name".
   Ein ausdrücklich übergebener Titel gewinnt aber – sonst bekäme die englische
   Startseite den deutschen Titel und wäre für Google eine Dublette der
   deutschen (im Zweisprachen-Test genau so aufgetreten). */
const vollerTitel =
  pfad === '/' && !titel
    ? `${site.betrieb.name} – ${site.betrieb.claim}`
    : `${seitenTitel} | ${site.betrieb.name}`;
const desc = beschreibung ?? seite?.metaBeschreibung ?? site.betrieb.kurzbeschreibung;
/**
 * Basis für alle absoluten Adressen im Seitenkopf.
 *
 * In der Vorschau ist das NICHT die Kundendomain: Die existiert noch nicht,
 * und WhatsApp holte das Vorschaubild dort vergeblich ab – der Lead bekam eine
 * graue Zeile ohne Foto. Reihenfolge: ausdrücklich gesetzte `vorschauDomain`,
 * sonst die Adresse, unter der Vercel gerade baut, sonst als letzter Ausweg
 * die Kundendomain. Im live-Modus zählt immer die Kundendomain.
 */
const vercelAdresse = import.meta.env.VERCEL_PROJECT_PRODUCTION_URL;
const basisAdresse =
  istDemo
    ? (site.vorschauDomain ?? (vercelAdresse ? `https://${vercelAdresse}` : site.domain))
    : site.domain;

/* Der tatsächliche Pfad DIESER Seite – bei Englisch mit Sprach-Präfix.
   `pfad` bleibt der deutsche Pfad, damit die Meta-Angaben und hreflang-Ziele
   aus derselben Config-Zeile kommen. */
const eigenerPfad = sprache === 'de' ? pfad : `/${sprache}${pfad === '/' ? '' : pfad}`;
const canonical = new URL(eigenerPfad, basisAdresse).href;
const ogBild = new URL(
  ogBildUrl ?? (seite?.ogBild ? `/${seite.ogBild}` : site.ogBild),
  basisAdresse,
).href;
const rootStyle = `:root { ${cssVariablen(site)} }`;

const mehrsprachig = site.sprachen.length > 1;

/** Kurzcodes -> volle schema.org-Tagesnamen. Google versteht NUR die vollen
    Namen ("Monday") – mit "Mo" würden die Öffnungszeiten still ignoriert. */
const TAG_LD: Record<string, string> = {
  Mo: 'Monday', Tu: 'Tuesday', We: 'Wednesday', Th: 'Thursday',
  Fr: 'Friday', Sa: 'Saturday', Su: 'Sunday',
};

/** Öffnungszeiten maschinenlesbar für JSON-LD (nur vollständige Angaben). */
const oeffnungszeitenLd = site.betrieb.oeffnungszeiten
  .filter((o) => o.tageISO?.length && o.vonISO && o.bisISO)
  .map((o) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: o.tageISO!.map((t) => TAG_LD[t] ?? t),
    opens: o.vonISO,
    closes: o.bisISO,
  }));

/**
 * Schriften vorladen – gegen das „Text hüpft kurz"-Problem (FOUT).
 *
 * fonts.css nutzt font-display: swap (richtig – Text darf nie unsichtbar
 * sein). Aber: Der Browser entdeckt Schriftdateien erst spät (CSS parsen →
 * Text ansehen → Datei anfordern). In dieser Lücke rendert die Ersatzschrift,
 * dann springt der Text auf die echte Schrift um. Mit rel="preload" starten
 * die Downloads sofort mit dem HTML – die Schrift ist praktisch immer vor dem
 * ersten Bild da.
 *
 * Vorgeladen werden NUR die Latin-Teilsätze (unicode-range U+0000-00FF …) –
 * die tragen den gesamten deutschen Text. Kyrillisch/Latin-Ext bleiben lazy;
 * sie vorzuladen wäre verschwendetes Datenvolumen und der Browser warnt über
 * ungenutzte Preloads. Fehlt einer Deklaration die unicode-range, wird sie
 * sicherheitshalber vorgeladen. Läuft zur BAUZEIT über fonts.css – funktioniert
 * damit für jede per `npm run schrift` eingebettete Schrift, kundenneutral.
 */
const schriftenVorladen = (() => {
  const urls = new Set<string>();
  for (const block of fontsCssRoh.match(/@font-face\s*{[^}]*}/g) ?? []) {
    const url = block.match(/url\('([^']+\.woff2)'\)/)?.[1];
    if (!url) continue;
    const range = block.match(/unicode-range:\s*([^;]+);/)?.[1];
    if (!range || /U\+0000-00FF/i.test(range)) urls.add(url);
  }
  return [...urls];
})();

/**
 * Feiertage und Betriebsurlaub für Google
 * (schema.org `specialOpeningHoursSpecification`).
 *
 * Ohne diese Angabe zeigt Google an Feiertagen die normalen Wochenzeiten – der
 * Gast steht vor der verschlossenen Tür, und die Website widerspricht dem
 * Google-Unternehmensprofil. Vergangene Einträge werden übersprungen, damit
 * keine alten Feiertage mitgeschleppt werden.
 */
const sonderzeitenLd = (site.betrieb.sonderzeiten ?? [])
  .filter((s) => {
    const ende = s.bis ?? s.datum;
    if (!ende) return false;
    // Nur Einträge, die heute noch bevorstehen oder laufen.
    return new Date(`${ende}T23:59:59`) >= new Date();
  })
  .map((s) => ({
    '@type': 'OpeningHoursSpecification',
    validFrom: s.von ?? s.datum,
    validThrough: s.bis ?? s.datum,
    // Ohne Uhrzeiten heißt das für Google: an diesem Tag geschlossen.
    opens: s.vonISO ?? '00:00',
    closes: s.bisISO ?? '00:00',
  }));

/**
 * Speisekarte / Preisliste für Google (schema.org `hasMenu`).
 *
 * Die Daten liegen ohnehin strukturiert in der Config – daraus entsteht ohne
 * Zusatzaufwand ein Menu-Objekt. Google kann damit Gerichte, Preise und
 * Kategorien direkt in der Suche zeigen (Rich Result „Speisekarte"); ohne die
 * Angabe bleibt die Karte für Google eine Textwüste. Preise werden zu Zahlen
 * normalisiert („4,80 €" -> 4.80), weil schema.org nur Zahlen versteht.
 */
const menuLd = (() => {
  const liste = site.preisliste;
  if (!liste || liste.kategorien.length === 0) return {};

  /* NUR auf der Seite, auf der die Karte auch WIRKLICH STEHT.
     Vorher hing die komplette Speisekarte (bei einem Piloten 178 Positionen,
     27 KB) an jeder einzelnen Seite – auch am Impressum, an der Datenschutz-
     erklärung und an der Fehlerseite. Google verlangt ausdrücklich, dass eine
     Auszeichnung den auf DIESER Seite sichtbaren Inhalt beschreibt; 178
     Gerichte auf der Datenschutzerklärung sind genau der Verstoß, den die
     Richtlinie „Markup, das den Nutzer nicht sieht" meint. Nebeneffekt: jede
     andere Seite wird um 27 KB leichter. */
  const kartenSeite = site.seiten.find((s) => s.zeigtPreisliste)?.pfad;
  if (kartenSeite ? pfad !== kartenSeite : pfad !== '/') return {};

  /* hasMenu ist eine Speisekarte – bei einem Friseur oder einer Werkstatt wäre
     das schlicht falsches Markup. Für alle anderen Branchen wird die Preisliste
     nicht als Menu ausgezeichnet (ein passendes Schema für Leistungen gibt es
     in schema.org nicht in vergleichbarer Form). */
  if (!['gastro', 'cafe', 'bar'].includes(site.branche)) return {};
  const zahl = (p?: string) => {
    if (!p) return undefined;
    const t = p.replace(/[^0-9,.]/g, '').replace(',', '.');
    const n = Number.parseFloat(t);
    return Number.isFinite(n) ? n.toFixed(2) : undefined;
  };
  return {
    hasMenu: {
      '@type': 'Menu',
      name: 'Karte',
      ...(liste.pdfDatei && { url: `${basisAdresse.replace(/\/$/, '')}/${liste.pdfDatei}` }),
      hasMenuSection: liste.kategorien.map((kat) => ({
        '@type': 'MenuSection',
        name: kat.titel,
        ...(kat.untertitel && { description: kat.untertitel }),
        hasMenuItem: kat.gruppen.flatMap((gruppe) =>
          gruppe.positionen
            .filter((pos) => zahl(pos.preis ?? pos.varianten?.[0]?.preis))
            .map((pos) => ({
              '@type': 'MenuItem',
              name: pos.name,
              ...(pos.beschreibung && { description: pos.beschreibung }),
              offers: {
                '@type': 'Offer',
                price: zahl(pos.preis ?? pos.varianten?.[0]?.preis),
                priceCurrency: 'EUR',
              },
            })),
        ),
      })),
    },
  };
})();

/**
 * FAQ-Schema – nur auf der Seite, die die Fragen auch zeigt.
 * Welche das ist, sagt `zeigtFaq` in der Seiten-Config; ohne Angabe die Seite,
 * deren Pfad '/faq' lautet, sonst gar keine (lieber kein Schema als eines,
 * das nichts mit dem Sichtbaren zu tun hat – das wertet Google ab).
 */
const faqLd = (() => {
  const eintraege = site.faq ?? [];
  if (eintraege.length === 0) return null;
  const faqSeite = site.seiten.find((s) => s.zeigtFaq)?.pfad ?? '/faq';
  if (pfad !== faqSeite) return null;
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: eintraege.map((f) => ({
      '@type': 'Question',
      name: f.frage,
      acceptedAnswer: { '@type': 'Answer', text: f.antwort },
    })),
  };
})();

/** Stellenanzeigen für Google Jobs – nur auf der Seite, die sie zeigt. */
const stellenLd = (() => {
  const stellen = site.stellen ?? [];
  if (stellen.length === 0) return [];
  const jobSeite = site.seiten.find((s) => s.zeigtStellen)?.pfad ?? '/jobs';
  if (pfad !== jobSeite) return [];
  return stellen.map((s) => ({
    '@context': 'https://schema.org',
    '@type': 'JobPosting',
    title: s.titel,
    description: s.text,
    employmentType: s.umfang,
    ...(s.ab && { datePosted: s.ab }),
    hiringOrganization: {
      '@type': 'Organization',
      name: site.betrieb.name,
      sameAs: basisAdresse,
    },
    jobLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.betrieb.adresse.strasse,
        postalCode: site.betrieb.adresse.plz,
        addressLocality: site.betrieb.adresse.ort,
        addressCountry: site.betrieb.adresse.land ?? 'AT',
      },
    },
    /* Das Gehalt ist in Österreich Pflichtangabe (§ 9 GlBG) und wird hier als
       Text übernommen – eine Zahl daraus zu erraten wäre eine erfundene
       Angabe, und die verbietet das Regelwerk. */
    ...(s.gehalt && { baseSalary: { '@type': 'MonetaryAmount', currency: 'EUR', value: { '@type': 'QuantitativeValue', unitText: 'MONTH' } } }),
  }));
})();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': jsonLdTyp(site.branche),
  '@id': basisAdresse,
  name: site.betrieb.name,
  description: site.betrieb.kurzbeschreibung,
  url: basisAdresse,
  telephone: site.betrieb.telefon,
  email: site.betrieb.email,
  image: ogBild,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.betrieb.adresse.strasse,
    postalCode: site.betrieb.adresse.plz,
    addressLocality: site.betrieb.adresse.ort,
    addressCountry: site.betrieb.adresse.land ?? 'AT',
  },
  ...(site.betrieb.breitengrad !== undefined && site.betrieb.laengengrad !== undefined && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.betrieb.breitengrad,
      longitude: site.betrieb.laengengrad,
    },
    hasMap: site.betrieb.adresse.googleMapsUrl,
  }),
  ...(site.betrieb.preisniveau && { priceRange: site.betrieb.preisniveau }),
  ...(oeffnungszeitenLd.length > 0 && { openingHoursSpecification: oeffnungszeitenLd }),
  ...(sonderzeitenLd.length > 0 && { specialOpeningHoursSpecification: sonderzeitenLd }),
  ...(site.betrieb.socialLinks.length > 0 && {
    sameAs: site.betrieb.socialLinks.map((s) => s.url),
  }),
  ...menuLd,
};
---

<!doctype html>
<html lang={sprache === 'de' ? 'de-AT' : sprache} data-animation={site.design.animation ?? 'dezent'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{vollerTitel}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    {/* Schriften sofort laden, nicht erst nach dem CSS-Parsen – sonst hüpft
        der Text von der Ersatzschrift auf die echte (Begründung oben).
        crossorigin ist bei Font-Preloads Pflicht, auch same-origin. */}
    {schriftenVorladen.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    {/* demo = Vorschau: nie indexieren. Die 404 ist AUCH live nie indexierbar.
        Der HTTP-Header kommt im demo-Modus zusätzlich. */}
    <meta
      name="robots"
      content={istDemo || noindex || pfad === '/404' ? 'noindex, nofollow' : 'index, follow'}
    />

    {/* Sprachverweise NUR für Seiten, die es wirklich in beiden Sprachen gibt.
        Hilfsseiten wie /danke oder /404 stehen nicht in der Seiten-Config und
        werden nicht übersetzt – für sie hreflang auszugeben hieße, Google eine
        englische Fassung zu versprechen, die es nicht gibt (das Prüf-Tor
        blockt das zu Recht).
        x-default zeigt auf die HAUPTSPRACHE, nicht auf die aktuelle Seite:
        Es beantwortet die Frage „welche Fassung, wenn keine passt?" – bisher
        zeigte jede Sprachfassung auf sich selbst, was die Angabe wertlos macht. */}
    {mehrsprachig && seite && site.sprachen.map((s) => (
      <link
        rel="alternate"
        hreflang={s}
        href={new URL(s === 'de' ? pfad : `/${s}${pfad === '/' ? '' : pfad}`, basisAdresse).href}
      />
    ))}
    {mehrsprachig && seite && (
      <link rel="alternate" hreflang="x-default" href={new URL(pfad, basisAdresse).href} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={vollerTitel} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={sprache === 'de' ? 'de_AT' : 'en_US'} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* site_name erscheint in der Vorschau über dem Titel; die Bild-
        Beschreibung liest ein Screenreader beim geteilten Link vor.
        X/Twitter wertet og:image:alt NICHT aus – dort braucht es die
        eigene Angabe, sonst bleibt das Bild dort unbeschriftet. */}
    <meta property="og:site_name" content={site.betrieb.name} />
    <meta property="og:image:alt" content={ogBildAlt ?? `${site.betrieb.name} – ${site.betrieb.kurzbeschreibung}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={vollerTitel} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogBild} />
    <meta name="twitter:image:alt" content={`${site.betrieb.name} – ${site.betrieb.kurzbeschreibung}`} />

    <meta name="theme-color" content={site.design.farben.primaer} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* `<` maskieren: Enthielte irgendein Config-Wert die Zeichenfolge
        </script> – etwa in einer Betriebsbeschreibung oder einem Gerichtsnamen –
        würde der Browser den Skriptblock an dieser Stelle beenden und den Rest
        als Seiteninhalt lesen. Aus einem Tippfehler wird so eine Sicherheits-
        lücke. < ist im JSON dasselbe Zeichen, beendet aber nichts. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003C')}
    />

    {/* Seiteneigene strukturierte Daten (z. B. das Produkt-Schema einer
        Katalog-Detailseite). Bewusst ein EIGENER Block neben dem Betriebs-
        Schema: Google liest beide, aber nur so bleibt erkennbar, welche
        Angabe zum Betrieb und welche zum einzelnen Eintrag gehoert. */}
    {zusatzLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(zusatzLd).replace(/</g, '\\u003C')}
      />
    )}

    {/* FAQ-Schema: Google zeigt die Fragen aufklappbar direkt im Suchergebnis –
        das vergrößert den eigenen Platz in der Trefferliste spürbar. Nur auf
        der Seite ausgeben, auf der die Fragen auch sichtbar stehen (Google
        verlangt das ausdrücklich). */}
    {faqLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqLd).replace(/</g, '\\u003C')} />
    )}

    {/* Stellenanzeigen für Google Jobs. Ohne das Schema erscheinen sie dort
        nicht – und Google Jobs ist für Kleinbetriebe oft die einzige Chance,
        ohne teure Inserate gefunden zu werden. */}
    {stellenLd.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003C')} />
    ))}

    {/* Design-Tokens: die Nahtstelle zwischen Claude Design und Motor. */}
    <style set:html={rootStyle}></style>
  </head>
  <body>
    {istDemo && <DemoBar />}
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <slot />

    {/* Rendert nur, wenn zustimmungspflichtige Dienste konfiguriert sind.
        Normalfall: nichts davon -> die Seite bleibt cookiefrei. */}
    <Einwilligung />

    <script>
      import { verhaltenStarten } from '../lib/verhalten';

      document.documentElement.classList.add('js');
      verhaltenStarten();

      // Dezentes Einblenden (progressive enhancement, ohne JS voll sichtbar).
      const ziele = document.querySelectorAll('[data-reveal]');
      const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduziert || !('IntersectionObserver' in window)) {
        ziele.forEach((el) => el.classList.add('ist-sichtbar'));
      } else {
        const io = new IntersectionObserver(
          (eintraege) => {
            eintraege.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('ist-sichtbar');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        ziele.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
