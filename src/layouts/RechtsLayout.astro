---
/**
 * Layout für die Rechts-Unterseiten (/impressum, /datenschutz).
 *
 * INHALTLICH Motor-Gebiet (automatisch erzeugt, immer formal) – aber OPTISCH
 * Teil der Website: Es benutzt DIESELBE Kopf- und Fußzeile wie jede andere
 * Seite. Früher hatte es ein eigenes Minimal-Layout mit „← Zur Startseite",
 * und jeder Port musste es von Hand umbauen; wer das vergaß, lieferte dem
 * Kunden ein Impressum, das aussah, als gehöre es nicht zur Website – genau
 * dort, wo auch prüfende Blicke landen.
 *
 * Baut das Design eine eigene Kopfleiste, tauscht der Port hier <Kopf/> und
 * <Fuss/> gegen die Kunden-Bausteine – das ist ein Zweizeiler statt eines
 * Umbaus.
 */
import BaseLayout from './BaseLayout.astro';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';

interface Props {
  titel: string;
  pfad: string;
  /** Eigene Meta-Description – jede Seite braucht eine eigene (prüft check.mjs). */
  beschreibung: string;
  /**
   * SPRACHE DIESER RECHTSSEITE.
   *
   * Ohne diesen Prop konnte ein Klon gar keine englische Rechtsseite bauen,
   * ohne am Motor zu schrauben. Gebraucht wird sie: Art. 12 Abs. 1 DSGVO
   * verlangt die Pflichtinformation in verständlicher Sprache, sobald ein
   * englisches Formular personenbezogene Daten erhebt.
   *
   * Erst dadurch bekommt eine Seite unter /en/ die richtige `lang`-Auszeichnung
   * und die richtigen Motortexte. Impressum und AGB bleiben üblicherweise
   * deutsch – siehe den Kommentar im Kopf von src/pages/datenschutz.astro.
   */
  sprache?: 'de' | 'en';
}
const { titel, pfad, beschreibung, sprache = 'de' } = Astro.props;
---

<BaseLayout pfad={pfad} titel={titel} beschreibung={beschreibung} sprache={sprache}>
  <Kopf aktuell={pfad} />
  <main id="inhalt" class="rechtsseite">
    <div class="container container--schmal">
      <h1>{titel}</h1>
      <div class="prose">
        <slot />
      </div>
    </div>
  </main>
  <Fuss />
</BaseLayout>

<style>
  .rechtsseite {
    padding-block: var(--raum-xl);
  }
  .rechtsseite h1 {
    font-size: var(--schrift-2xl);
    margin-bottom: var(--raum-m);
  }
  .prose :global(h2) {
    font-size: var(--schrift-l);
    margin: var(--raum-m) 0 var(--raum-2xs);
  }
  .prose :global(h3) {
    font-size: var(--schrift-m);
    margin: var(--raum-s) 0 var(--raum-3xs);
  }
  .prose :global(p) {
    margin-bottom: var(--raum-xs);
  }
  .prose :global(ul) {
    margin: 0 0 var(--raum-xs) var(--raum-s);
    display: grid;
    gap: var(--raum-3xs);
  }
  .prose :global(address) {
    font-style: normal;
    margin-bottom: var(--raum-xs);
  }
  /* Lange URLs/E-Mails dürfen schmale Screens nicht sprengen. */
  .prose :global(a) {
    word-break: break-word;
  }
</style>
