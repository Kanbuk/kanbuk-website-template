---
import RechtsLayout from '../layouts/RechtsLayout.astro';
import { site } from '../../content.config';

const r = site.rechtstexte;
/* Ohne Telefonnummer entfällt die Zeile ganz – nicht jeder Betrieb hat eine
   (ein Studio, das Termine nur über Instagram vergibt, etwa). § 5 ECG verlangt
   „Angaben, die eine schnelle elektronische Kontaktaufnahme ermöglichen";
   die E-Mail-Adresse erfüllt das, eine leere Telefonzeile erfüllt gar nichts. */
const hatTelefon = Boolean(site.betrieb.telefon);
const telVerlinkt = site.mode === 'live';
const telHref = 'tel:' + (site.betrieb.telefon ?? '').replace(/[^+0-9]/g, '');
---

<RechtsLayout
  titel="Impressum"
  pfad="/impressum"
  beschreibung={`Impressum und Offenlegung von ${site.betrieb.name} gemäß § 5 ECG, § 14 UGB und § 25 Mediengesetz: Medieninhaber, Unternehmensdaten, Kontakt und Aufsichtsbehörde.`}
>
  <p>Offenlegung gemäß § 5 ECG, § 14 UGB und § 25 Mediengesetz.</p>

  {/* GENAU EIN MEDIENINHABER. § 25 MedienG verlangt eine eindeutige Angabe.
      Stünde hier oben die Gesellschaft und weiter unten noch eine Person als
      zweiter „Inhaber", wäre genau das nicht mehr eindeutig – ein Fall, der in
      einem Kundenprojekt so im Impressum stand. Wer vertritt, steht deshalb
      getrennt als „Vertretungsbefugt" bei den Unternehmensdaten. */}
  <h2>Medieninhaber &amp; Diensteanbieter</h2>
  <address>
    <strong>{r.firmenwortlaut}</strong><br />
    {r.adresse}
  </address>

  <h2>Kontakt</h2>
  <p>
    {hatTelefon && (
      <>
        Telefon: {telVerlinkt ? <a href={telHref}>{site.betrieb.telefon}</a> : <span>{site.betrieb.telefon}</span>}<br />
      </>
    )}
    E-Mail: <a href={`mailto:${site.betrieb.email}`}>{site.betrieb.email}</a>
  </p>

  <h2>Unternehmensdaten</h2>
  <ul>
    <li>Rechtsform: {r.rechtsform}</li>
    {/* Sitz = GEMEINDE (§ 14 UGB), nicht die vollständige Anschrift. Bei
        kleinen Betrieben ist der Firmenbuch-Sitz oft eine Wohnadresse; ohne
        diese Trennung veröffentlicht man entweder sie oder lässt eine
        Pflichtangabe weg. Fehlt das Feld, sagt die Anschrift oben beides. */}
    {r.sitz && <li>Sitz: {r.sitz}</li>}
    {/* „Inhaber" gibt es bei OG, KG und GmbH nicht – dort vertritt jemand. */}
    {r.vertretungsbefugt && <li>Vertretungsbefugt: {r.vertretungsbefugt}</li>}
    {r.uid && <li>UID-Nummer: {r.uid}</li>}
    {r.firmenbuchnummer && <li>Firmenbuchnummer: {r.firmenbuchnummer}</li>}
    {r.firmenbuchgericht && <li>Firmenbuchgericht: {r.firmenbuchgericht}</li>}
    {r.gewerbe && <li>Gewerbe: {r.gewerbe}</li>}
    {r.aufsichtsbehoerde && <li>Aufsichtsbehörde: {r.aufsichtsbehoerde}</li>}
  </ul>

  {/* § 5 Abs. 1 Z 6 ECG verlangt neben der Kammer AUSDRÜCKLICH die anwendbaren
      berufsrechtlichen Vorschriften UND einen Zugang dazu. Von den acht Punkten
      des § 5 Abs. 1 war das lange der einzige, der fehlte – auffällig gerade
      deshalb, weil die Seite oben die Norm selbst zitiert.

      Der RIS-Link ist die amtliche Fundstelle und für jedes Gewerbe derselbe;
      die konkrete Gewerbeordnung steht schon in `gewerbe`. Freie Berufe
      (Ärzte, Anwälte, Ziviltechniker) brauchen hier stattdessen ihre eigene
      Kammer-Fundstelle – siehe den Vermerk „Gesundheitsberufe" in STAND.md. */}
  <h2>Berufsrechtliche Vorschriften</h2>
  <p>
    Es gelten die Gewerbeordnung 1994 (GewO) sowie die für das ausgeübte Gewerbe
    einschlägigen Verordnungen. Abrufbar im Rechtsinformationssystem des Bundes:{' '}
    <a href="https://www.ris.bka.gv.at/" target="_blank" rel="noopener noreferrer">
      www.ris.bka.gv.at
    </a>
  </p>

  {/* OFFENLEGUNG NACH § 25 MEDIENGESETZ.
      Der Unternehmensgegenstand ist auch in der abgespeckten Fassung für kleine
      Websites Pflicht (§ 25 Abs. 5). Er fehlte hier lange – während der Text
      oben die Norm ausdrücklich nannte. Eine Pflichtnorm zu nennen und nicht zu
      erfüllen ist schlechter, als sie gar nicht zu nennen.
      Blattlinie (Abs. 4) und Beteiligungen (Abs. 2) betreffen Gesellschaften;
      sie erscheinen nur, wenn sie gepflegt sind. */}
  <h2>Offenlegung nach § 25 Mediengesetz</h2>
  <ul>
    <li>Unternehmensgegenstand: {r.unternehmensgegenstand}</li>
    {r.blattlinie && <li>Grundlegende Richtung: {r.blattlinie}</li>}
    {r.beteiligungen && r.beteiligungen.length > 0 && (
      <li>
        Beteiligungsverhältnisse:{' '}
        {r.beteiligungen.join('; ')}
      </li>
    )}
  </ul>

  <h2>Anwendbares Recht</h2>
  <p>Es gilt österreichisches Recht.</p>

  {/* Die EU-Online-Streitbeilegungsplattform (ec.europa.eu/consumers/odr) wurde
      am 20.07.2025 eingestellt (VO (EU) 2024/3228). Der früher übliche Link darf
      NICHT mehr gesetzt werden – die WKO rät zur Entfernung, ein toter
      Pflicht-Link ist abmahnbar. Es bleibt nur die freiwillige Erklärung. */}
  <h2>Verbraucherstreitbeilegung</h2>
  <p>
    Wir sind nicht verpflichtet und nicht bereit, an einem Streitbeilegungsverfahren vor
    einer Verbraucherschlichtungsstelle teilzunehmen.
  </p>

  <h2>Haftung für Inhalte</h2>
  <p>
    Die Inhalte dieser Website wurden mit größtmöglicher Sorgfalt erstellt. Für die
    Richtigkeit, Vollständigkeit und Aktualität der Inhalte können wir keine Gewähr
    übernehmen. Für Inhalte externer Links sind ausschließlich deren Betreiber
    verantwortlich.
  </p>
</RechtsLayout>
