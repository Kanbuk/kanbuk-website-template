---
/**
 * Anfrage fehlgeschlagen – das Ziel, wenn eine Formular-Sendung NICHT ankam.
 *
 * WARUM ES EINE EIGENE SEITE IST UND KEIN ZUSATZ AN DER ADRESSE:
 * Bis zum 30.07.2026 führten Erfolg und Fehler beide auf `/danke`, und der
 * Unterschied stand als `?fehler=…` in der Adresse. Ausgewertet hat ihn ein
 * Skript – ausgerechnet auf dem Weg, den **ausschließlich Besucher OHNE
 * Skript** gehen. Eine statisch gebaute Seite kann die Adresszeile nicht
 * lesen. Ergebnis: Wem die Anfrage gerade misslungen war, dem dankte die Seite
 * dafür. Er ging zufrieden weg und hat nie wieder angefragt.
 *
 * Die ROUTE entscheidet, nicht ein Zusatz: Erfolg → /danke, Fehler → hier.
 * Das funktioniert ohne eine Zeile JavaScript.
 *
 * WARUM EIN TEXT FÜR BEIDE URSACHEN: Ohne Skript prüft der Browser die
 * Pflichtfelder selbst – `novalidate` setzt erst das Skript, und zwar erst,
 * wenn es die Prüfung wirklich übernimmt (src/lib/verhalten/formular.ts).
 * Eine unvollständige Sendung erreicht den Server also nur noch, wenn der
 * Browser gar keine Feldprüfung kennt. Zwei Fehlerseiten für einen Fall, den
 * es fast nicht gibt, wären zwei Stellen zum Pflegen.
 *
 * Nicht indexiert: Diese Seite in den Suchergebnissen wäre für niemanden
 * nützlich, und sie gehört auch nicht in die Sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { site } from '../../content.config';

const duzen = site.ansprache === 'du';
---

<BaseLayout
  pfad="/anfrage-fehler"
  titel="Die Anfrage kam nicht an"
  beschreibung="Die Nachricht konnte nicht entgegengenommen werden. Hier stehen die direkten Kontaktwege."
  noindex
>
  <Kopf aktuell="/anfrage-fehler" />
  <main id="inhalt" class="danke">
    <div class="container container--schmal">
      <h1 class="danke__titel">Das hat leider nicht geklappt</h1>
      {/* DER TEXT MUSS ALLE WEGE ABDECKEN, DIE HIERHER FÜHREN.
          Hier standen zwei Ursachen („eine Angabe gefehlt" oder „bei uns ist
          etwas schiefgegangen"), angesteuert wird die Seite aber von dreien:
          403 (Ursprung passt nicht), 413 (Nachricht zu lang) und 429 (zu viele
          Versuche). Ein Besucher ohne laufendes JavaScript – Skript lädt
          nicht, altes Gerät, Firmen-Proxy – las also eine Ursache, die auf
          seinen Fall nicht zutrifft.

          Und der Rat „bitte noch einmal versuchen" war ausgerechnet im
          häufigsten Fall falsch: Nach dem 429 hält die Sperre zehn Minuten
          (FENSTER_MS in api/contact.ts). Ohne Skript entstand daraus eine
          Schleife – senden, gesperrt, „noch einmal versuchen", senden,
          wieder gesperrt. Deshalb steht der direkte Kontaktweg jetzt vorn. */}
      <p class="danke__text">
        {duzen
          ? 'Deine Nachricht konnte gerade nicht entgegengenommen werden. Das kann mehrere Gründe haben: eine fehlende Angabe, eine sehr lange Nachricht, mehrere Versuche kurz hintereinander – oder ein Fehler bei uns. Am schnellsten erreichst du uns direkt:'
          : 'Ihre Nachricht konnte gerade nicht entgegengenommen werden. Das kann mehrere Gründe haben: eine fehlende Angabe, eine sehr lange Nachricht, mehrere Versuche kurz hintereinander – oder ein Fehler bei uns. Am schnellsten erreichen Sie uns direkt:'}
      </p>
      <p class="danke__text">
        {site.mode === 'live' ? (
          <a href={`tel:${site.betrieb.telefon.replace(/[^+0-9]/g, '')}`}>{site.betrieb.telefon}</a>
        ) : (
          <span>{site.betrieb.telefon}</span>
        )}
        {' · '}
        <a href={`mailto:${site.betrieb.email}`}>{site.betrieb.email}</a>
      </p>
      <p><a class="danke__zurueck" href="/">← Zurück zur Startseite</a></p>
    </div>
  </main>
  <Fuss />
</BaseLayout>

<style>
  .danke {
    padding-block: var(--raum-2xl);
  }
  .danke__titel {
    font-size: var(--schrift-2xl);
    margin-bottom: var(--raum-s);
  }
  .danke__text {
    margin-bottom: var(--raum-s);
  }
  .danke__zurueck {
    /* Wie auf /danke: Der Rückweg ist hier das einzige Bedienelement, also
       bekommt er die volle Fingerfläche direkt – kein Pseudo-Element nötig. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--raum-s);
  }
</style>
