---
import RechtsLayout from '../layouts/RechtsLayout.astro';
import { site, brauchtEinwilligung, type Kategorie } from '../../content.config';

const r = site.rechtstexte;

/** Sobald Dienste aktiv sind, MUSS die Erklärung sie nennen (Rechtspflicht). */
const hatDienste = brauchtEinwilligung(site);

const KATEGORIE_TITEL: Record<string, string> = {
  funktional: 'Komfort-Dienste',
  statistik: 'Statistik / Reichweitenmessung',
  marketing: 'Marketing',
};

/** Dienste nach Kategorie gruppieren – so liest es sich wie eine Behörde es erwartet. */
const dienstNachKategorie = (['funktional', 'statistik', 'marketing'] as Kategorie[])
  .map((k) => [k, site.dienste.filter((d) => d.kategorie === k)] as const)
  .filter(([, liste]) => liste.length > 0);

/* ---------------------------------------------------------------------------
 *  WAS DIE SEITE WIRKLICH EINBETTET – aus dem Markup gelesen, nicht behauptet
 *
 *  Vorher gab es genau EINEN Absatz („Karte / Anfahrt"), gesteuert von einem
 *  Handschalter in der Config. Der Baustein `<Einbettung>` ist aber allgemein –
 *  er trägt Google Maps, ein Video oder einen Instagram-Beitrag. Bettete ein
 *  Klon ein Video ein, stand dazu KEIN Wort in der Erklärung; es gab nicht
 *  einmal einen Schalter dafür. Und der Schalter selbst ging schief: In einem
 *  Kundenprojekt war die 2-Klick-Karte zwanzig Minuten online, während die
 *  Erklärung wörtlich behauptete „Es wird keine Karte eingebettet".
 *
 *  Deshalb wird jetzt der Quelltext der Seiten durchsucht. Die Wahrheit steht
 *  damit nur noch an EINER Stelle: dort, wo die Einbettung wirklich steht.
 *  Das Prüf-Tor hält beides zusätzlich gegeneinander.
 * ------------------------------------------------------------------------ */
const seitenQuellen = import.meta.glob<string>('/src/**/*.astro', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const einbettungsAnbieter = [
  ...new Set(
    Object.entries(seitenQuellen)
      // Die Erklärung selbst und der Baustein zählen nicht als Einsatz.
      .filter(([pfad]) => !/datenschutz\.astro$|Einbettung\.astro$/.test(pfad))
      .flatMap(([, quelle]) =>
        [...String(quelle).matchAll(/<Einbettung\b[^>]*?anbieter=["']([^"']+)["']/g)].map((m) => m[1]),
      ),
  ),
].sort();

/* Dienste, die Daten in ein Drittland geben – NAMENTLICH. Vorher entstand der
   USA-Absatz allein daraus, DASS überhaupt ein Dienst eingetragen war. Bei
   einem europäischen Werkzeug behauptete die Erklärung damit eine
   Übermittlung, die es gar nicht gibt – samt falscher Rechtsgrundlage. */
/* Ein Dienst OHNE `drittland`-Angabe taucht hier bewusst nirgends auf: Die
   Erklärung darf nichts behaupten, was niemand eingetragen hat. Dass die
   Angabe fehlt, meldet das Prüf-Tor (scripts/check.mjs) – dort gehört sie hin,
   nicht in eine Rechtsseite, die sie dann irgendwie formulieren müsste. */
const drittlandDienste = site.dienste.filter((d) => d.drittland && d.drittland !== 'keines');
---

<RechtsLayout
  titel="Datenschutzerklärung"
  pfad="/datenschutz"
  beschreibung={
    hatDienste
      ? `Datenschutzerklärung von ${site.betrieb.name}: welche Daten wir verarbeiten, welche Dienste wir einsetzen und welche Rechte Sie haben – inklusive Widerruf Ihrer Einwilligung.`
      : `Datenschutzerklärung von ${site.betrieb.name}: welche Daten wir verarbeiten, auf welcher Grundlage und welche Rechte Sie haben. Diese Website nutzt keine Cookies.`
  }
>
  <p>
    Der Schutz Ihrer persönlichen Daten ist uns wichtig. Wir verarbeiten Ihre Daten
    ausschließlich auf Grundlage der gesetzlichen Bestimmungen (DSGVO, TKG 2021).
  </p>

  <h2>Verantwortlicher</h2>
  <address>
    <strong>{r.firmenwortlaut}</strong><br />
    {r.adresse}<br />
    E-Mail: <a href={`mailto:${site.betrieb.email}`}>{site.betrieb.email}</a>
  </address>

  {/* Dieser Abschnitt richtet sich nach content.config.ts -> dienste.
      Ohne Dienste ist die Seite cookiefrei; sobald einer aktiv ist, wäre die
      Aussage „keine Cookies" falsch – und eine falsche Datenschutzerklärung
      ist ein echtes Rechtsrisiko. Deshalb schaltet der Text automatisch um. */}
  {!hatDienste ? (
    <>
      <h2>Keine Cookies, kein Tracking</h2>
      <p>
        Diese Website verwendet <strong>keine Cookies</strong>, kein Analyse-Werkzeug und
        keine Tracking-Skripte. Es werden keine Nutzungsprofile erstellt. Deshalb benötigt
        diese Seite auch keinen Cookie-Banner.
      </p>
    </>
  ) : (
    <>
      <h2>Einwilligung, Cookies und externe Dienste</h2>
      <p>
        Diese Website nutzt Dienste, die erst geladen werden, <strong>nachdem Sie
        zugestimmt haben</strong>. Ohne Ihre Einwilligung wird nichts davon geladen, es
        werden keine Daten an diese Anbieter übertragen und keine Cookies gesetzt
        (Art. 6 Abs. 1 lit. a DSGVO, § 165 Abs. 3 TKG 2021).
      </p>
      <p>
        Ihre Entscheidung speichern wir lokal in Ihrem Browser (localStorage) – dabei
        werden keine Daten an uns übertragen. Gespeichert werden nur die von Ihnen
        freigegebenen Kategorien, der Zeitpunkt und eine Kennung der Dienste-Liste.
        Der Eintrag bleibt, bis Sie ihn selbst löschen <strong>oder wir die Liste der
        Dienste ändern – dann werden Sie automatisch erneut gefragt</strong>.
        Sie können Ihre Einwilligung jederzeit mit
        Wirkung für die Zukunft widerrufen:
        {' '}<button type="button" class="ds-widerruf" data-einwilligung-widerruf>Einwilligung widerrufen</button>.
      </p>

      {dienstNachKategorie.map(([kategorie, liste]) => (
        <>
          <h3>{KATEGORIE_TITEL[kategorie] ?? kategorie}</h3>
          <ul>
            {liste.map((d) => (
              <li>
                <strong>{d.name}</strong> – Anbieter: {d.anbieter}.<br />
                Zweck: {d.zweck}.
                {d.setztCookies && <> Dieser Dienst setzt Cookies.</>}
                {' '}Datenschutzerklärung des Anbieters:{' '}
                <a href={d.datenschutzUrl} target="_blank" rel="noopener noreferrer">{d.datenschutzUrl}</a>
              </li>
            ))}
          </ul>
        </>
      ))}

      {drittlandDienste.length > 0 && (
        <>
          <h3>Übermittlung in Drittländer</h3>
          <p>
            Bei den folgenden Diensten werden Daten außerhalb der EU verarbeitet:
          </p>
          <ul>
            {drittlandDienste.map((d) => (
              <li>
                <strong>{d.name}</strong> ({d.anbieter}) – {d.drittland}
              </li>
            ))}
          </ul>
          <p>
            Rechtsgrundlage ist Ihre Einwilligung (Art. 6 Abs. 1 lit. a, Art. 49 Abs. 1
            lit. a DSGVO). Alle übrigen genannten Dienste verarbeiten ausschließlich
            innerhalb der EU beziehungsweise des EWR.
          </p>
        </>
      )}
    </>
  )}

  {/* Ein Absatz je TATSÄCHLICH eingebettetem Anbieter – siehe Kopf dieser
      Datei. Kein Handschalter mehr: Was im Markup steht, steht hier. */}
  {einbettungsAnbieter.length > 0 ? (
    <>
      <h2>Eingebettete Inhalte (Zwei-Klick-Lösung)</h2>
      <p>
        An einzelnen Stellen binden wir Inhalte fremder Anbieter ein. Sie werden
        <strong> erst geladen, wenn Sie darauf klicken</strong> – vorher wird nichts
        übertragen. Der Klick ist Ihre Einwilligung für diesen Fall
        (Art. 6 Abs. 1 lit. a DSGVO).
      </p>
      <ul>
        {einbettungsAnbieter.map((anbieter) => (
          <li>
            <strong>{anbieter}</strong> – beim Klick werden Ihre <strong>IP-Adresse</strong>{' '}
            und Angaben zu Ihrem Browser an diesen Anbieter übertragen. Es gelten dann
            zusätzlich dessen Datenschutzbestimmungen.
          </li>
        ))}
      </ul>
      <p>
        Für die Anfahrt zeigen wir zusätzlich ein <strong>statisches Kartenbild</strong>
        (Kartendaten von OpenStreetMap, beim Erstellen der Seite eingebunden) – dabei
        wird nichts übertragen.
      </p>
    </>
  ) : (
    <>
      <h2>Karte / Anfahrt</h2>
      <p>
        Für die Anfahrt zeigen wir ein <strong>statisches Bild</strong> (Kartendaten von
        OpenStreetMap, beim Erstellen der Seite eingebunden). Es wird keine Karte
        eingebettet, es werden also keine Daten übertragen, solange Sie nicht selbst auf
        den Link „In Google Maps öffnen" klicken. Erst dann gelangen Sie zu Google Maps,
        wo die Datenschutzbestimmungen von Google gelten.
      </p>
    </>
  )}

  <h2>Server-Logfiles (Hosting)</h2>
  <p>
    Beim Aufruf der Website werden durch den Hosting-Anbieter automatisch technische Daten
    (z. B. IP-Adresse, Datum und Uhrzeit, aufgerufene Seite, Browsertyp) in sogenannten
    Server-Logfiles gespeichert. Diese Verarbeitung dient dem sicheren und stabilen Betrieb
    (Art. 6 Abs. 1 lit. f DSGVO). Die Daten werden nicht mit anderen Quellen zusammengeführt.
  </p>

  {/* Die aufgezählten Daten kommen aus den ECHTEN Formularfeldern. Vorher stand
      hier eine feste Liste (Name, E-Mail, Telefon, Nachricht) – bei einem
      Reservierungsformular mit Datum, Uhrzeit und Personenzahl nannte die
      Erklärung also weniger Daten, als tatsächlich erhoben werden. */}
  {site.formulare.length > 0 && (
    <>
      <h2>{site.formulare.length > 1 ? 'Formulare' : 'Kontaktformular'}</h2>
      <p>
        Wenn Sie uns über {site.formulare.length > 1 ? 'eines unserer Formulare' : 'das Kontaktformular'}
        {' '}schreiben, verarbeiten wir die von Ihnen angegebenen Daten, um Ihre Anfrage zu
        beantworten (Art. 6 Abs. 1 lit. b und f DSGVO). Der Versand an unser Postfach
        erfolgt über den Dienst <strong>Resend</strong>
        {site.versandRegion === 'EU' ? (
          <> (Resend, Inc.; die Verarbeitung findet in der Europäischen Union statt)</>
        ) : (
          <> (Resend, Inc., USA – abgesichert über die EU-Standardvertragsklauseln)</>
        )}. Wir geben Ihre Daten nicht ohne Ihre
        Einwilligung an weitere Dritte weiter und speichern sie nur so lange, wie es zur
        Bearbeitung Ihrer Anfrage erforderlich ist.
      </p>
      <ul>
        {site.formulare.map((f) => (
          <li>
            <strong>{f.betreff}:</strong>{' '}
            {f.felder.map((feld) => feld.label).join(', ')}
          </li>
        ))}
      </ul>

      {/* WAS DER MOTOR SONST NOCH TUT – und was hier lange fehlte.
          Alle drei Punkte stecken in Motor-Dateien (api/contact.ts,
          src/lib/kontakt.ts), nicht in Kundendaten. Sie treffen also JEDEN
          Klon; in einem Kundenprojekt mussten sie in mehreren Prüfrunden
          nachgetragen werden. */}
      <p>
        Beim Absenden werden zusätzlich <strong>technisch notwendige Angaben</strong>
        mitgeschickt: welches Formular es war und wann die Seite geladen wurde. Beides
        dient ausschließlich der Abwehr automatisierter Massenzusendungen und wird nicht
        ausgewertet.
      </p>
      <p>
        Ihre <strong>IP-Adresse</strong> wird beim Absenden für kurze Zeit im
        Arbeitsspeicher unseres Servers gezählt, um zu erkennen, ob aus einer Quelle
        auffällig viele Anfragen kommen. Sie wird nicht gespeichert, nicht protokolliert
        und nach wenigen Minuten verworfen (Art. 6 Abs. 1 lit. f DSGVO – Schutz vor
        Missbrauch).
      </p>
      <p>
        Haben Sie eine E-Mail-Adresse angegeben, senden wir Ihnen eine automatische
        <strong> Empfangsbestätigung</strong>. Sie enthält <strong>keine</strong> Ihrer
        Angaben, sondern nur den Hinweis, dass die Anfrage angekommen ist, und unsere
        Kontaktdaten.
      </p>
    </>
  )}

  {/* MERKLISTE. Sie liegt im Speicher des GERÄTS (localStorage), geht an
      keinen Server und braucht kein Banner – sie ist funktional und wird vom
      Besucher selbst ausgelöst. Zwei Pflichten bleiben trotzdem: Sie muss hier
      stehen (§ 165 TKG / ePrivacy erfassen jede Speicherung auf dem Endgerät),
      und die Aussage „keine Cookies" oben darf nicht so stehen bleiben, als
      würde gar nichts gespeichert. Der Absatz erscheint nur, wenn es einen
      Katalog gibt – nur dort gibt es überhaupt etwas zum Vormerken. */}
  {site.katalog && (
    <>
      <h2>Merkliste</h2>
      <p>
        Wenn Sie einen Eintrag vormerken, speichert Ihr Browser die Kennung dieses
        Eintrags <strong>auf Ihrem Gerät</strong> (im sogenannten lokalen Speicher).
        Diese Angabe wird <strong>nicht an uns übertragen</strong>, nicht ausgewertet
        und nicht mit anderen Daten verknüpft – wir erfahren nicht, was Sie sich
        vorgemerkt haben. Es handelt sich um kein Cookie, sondern um eine von Ihnen
        selbst ausgelöste Funktion. Sie können die Merkliste jederzeit leeren, indem
        Sie die Einträge wieder abwählen oder die Websitedaten in Ihrem Browser
        löschen.
      </p>
    </>
  )}

  {/* Auftragsverarbeiter, die bei JEDEM Klon mitlaufen. Sie fehlten komplett –
      dabei verarbeitet der Hosting-Anbieter bei jedem Seitenaufruf die
      IP-Adresse des Besuchers. */}
  <h2>Hosting</h2>
  <p>
    Diese Website wird bei <strong>Vercel Inc.</strong> (340 S Lemon Ave #4133, Walnut,
    CA 91789, USA) gehostet. Beim Aufruf der Seite verarbeitet Vercel technisch
    notwendige Verbindungsdaten (u. a. IP-Adresse, Zeitpunkt, aufgerufene Adresse,
    Browsertyp) in Server-Protokollen. Rechtsgrundlage ist unser berechtigtes Interesse
    an einem sicheren und zuverlässigen Betrieb (Art. 6 Abs. 1 lit. f DSGVO). Mit Vercel
    besteht ein Auftragsverarbeitungsvertrag; die Übermittlung in die USA ist über die
    EU-Standardvertragsklauseln und den EU-US Data Privacy Framework abgesichert.
  </p>

  <h2>Ihre Rechte</h2>
  <p>Ihnen stehen nach der DSGVO folgende Rechte zu:</p>
  <ul>
    <li>Auskunft über die zu Ihrer Person gespeicherten Daten (Art. 15)</li>
    <li>Berichtigung unrichtiger Daten (Art. 16)</li>
    <li>Löschung (Art. 17) und Einschränkung der Verarbeitung (Art. 18)</li>
    <li>Datenübertragbarkeit (Art. 20)</li>
    <li>Widerspruch gegen die Verarbeitung (Art. 21)</li>
  </ul>
  <p>
    Wenden Sie sich dazu bitte an <a href={`mailto:${site.betrieb.email}`}>{site.betrieb.email}</a>.
    Außerdem haben Sie das Recht auf Beschwerde bei der österreichischen Datenschutzbehörde
    (<a href="https://www.dsb.gv.at" target="_blank" rel="noopener noreferrer">www.dsb.gv.at</a>).
  </p>
</RechtsLayout>
