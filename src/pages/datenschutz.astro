---
/**
 * Die deutsche Datenschutzerklärung.
 *
 * Der INHALT steht in src/components/DatenschutzInhalt.astro – dort einmal,
 * in beiden Sprachen nebeneinander. Diese Datei ist nur die Route.
 *
 * Braucht ein Klon eine englische Fassung, entsteht sie als
 * `src/pages/en/datenschutz.astro` nach demselben Muster mit `sprache="en"`.
 * Eine Handkopie der ganzen Seite gab es hier früher – sie fiel bei jeder
 * Weiterentwicklung des Motors zurück. Warum das der teuerste Fehler dieser
 * Datei wäre, steht im Kopf des Bausteins.
 */
import RechtsLayout from '../layouts/RechtsLayout.astro';
import DatenschutzInhalt from '../components/DatenschutzInhalt.astro';
import { site, brauchtEinwilligung } from '../../content.config';

const hatDienste = brauchtEinwilligung(site);
---

<RechtsLayout
  titel="Datenschutzerklärung"
  pfad="/datenschutz"
  beschreibung={
    hatDienste
      ? `Datenschutzerklärung von ${site.betrieb.name}: welche Daten wir verarbeiten, welche Dienste wir einsetzen und welche Rechte Sie haben – inklusive Widerruf Ihrer Einwilligung.`
      : `Datenschutzerklärung von ${site.betrieb.name}: welche Daten wir verarbeiten, auf welcher Grundlage und welche Rechte Sie haben. Diese Website nutzt keine Cookies.`
  }
>
  <DatenschutzInhalt sprache="de" />
</RechtsLayout>
