---
/**
 * AGB – die Seite entsteht NUR, wenn `rechtstexte.agb` gefüllt ist.
 *
 * Deshalb steht sie in einer Sammel-Route statt in `agb.astro`: Eine normale
 * Seitendatei erzeugt IMMER eine Seite. Ohne Text wäre das eine leere Adresse
 * unter /agb – in der Sitemap, im Google-Index, ohne Inhalt. Über
 * `getStaticPaths` entsteht sie gar nicht erst.
 *
 * Der Motor liefert die Seite (Adresse, Meta-Angaben, Kopf und Fuß wie
 * überall). Den TEXT liefert der Betrieb: AGB sind Vertragsrecht, keine
 * Textbausteine – wir erfinden hier keine Klausel. Steht im Text noch
 * `PLATZHALTER: …`, hält das Prüf-Tor den Live-Gang an.
 *
 * UND DIE SEITE HIELT SICH SELBST NICHT DARAN. Sie rahmte die Abschnitte des
 * Betriebs mit zwei EIGENEN Klauseln ein: einem Geltungsbereich („Diese
 * Bedingungen gelten für alle Verträge …") und einer Rechtswahl samt
 * Verbraucher-Vorbehalt. Beides sind materielle Vertragsklauseln, keine
 * Seitenmechanik – und sie standen ausserhalb dessen, was der Anwalt oder die
 * WKO geliefert hat. Bringt der gelieferte Text seinen eigenen
 * Geltungsbereich mit (das ist der Normalfall), standen dort zwei, die sich
 * widersprechen können. Beide sind seit 03.08.2026 raus.
 *
 * Gehören sie in die AGB? Fast sicher ja – aber dann als Abschnitt in
 * `rechtstexte.agb`, geliefert vom Betrieb. Nicht als Zutat des Motors.
 */
import RechtsLayout from '../layouts/RechtsLayout.astro';
import { site, type AgbAbschnitt } from '../../content.config';

export async function getStaticPaths() {
  const { site } = await import('../../content.config');
  const abschnitte = site.rechtstexte.agb ?? [];
  if (abschnitte.length === 0) return [];
  return [{ params: { agb: 'agb' } }];
}

const abschnitte: AgbAbschnitt[] = site.rechtstexte.agb ?? [];

/**
 * Trägt der Titel schon eine Nummer, bleibt SIE stehen.
 *
 * Vorher nummerierte die Seite stur nach Position im Array. Übernimmt ein Klon
 * die AGB des Betriebs 1:1 – und genau so soll er es tun, AGB sind
 * Vertragsrecht –, dann tragen die Überschriften ihre Nummern bereits mit:
 * Auf der Seite stand „1. 1. Allgemeines".
 *
 * Schlimmer ist der zweite Fall. Bei einem zweisprachigen Beauty-Piloten sprang die Nummerierung
 * des Originals von 9 auf 11 (eine Klausel war gestrichen worden, ohne neu zu
 * nummerieren). Eine Zählung nach Position hätte daraus stillschweigend
 * „10. Sonstiges" gemacht – also einen VERTRAGSTEXT umnummeriert, ohne dass es
 * jemandem auffällt. Die Nummer gehört dem Betrieb, nicht dem Zähler.
 */
const hatNummer = (titel: string) => /^\s*\d+[.)]/.test(titel);
---

<RechtsLayout
  titel="Allgemeine Geschäftsbedingungen"
  pfad="/agb"
  beschreibung={`Allgemeine Geschäftsbedingungen von ${site.betrieb.name}: Vertragsabschluss, Leistungen, Preise, Zahlung, Storno und Gewährleistung – vollständig zum Nachlesen.`}
>
  {abschnitte.map((a, i) => (
    <>
      <h2>{hatNummer(a.titel) ? a.titel : `${i + 1}. ${a.titel}`}</h2>
      {a.absaetze.map((p) => <p>{p}</p>)}
    </>
  ))}

  <p>
    Fragen zu diesen Bedingungen:{' '}
    <a href={`mailto:${site.betrieb.email}`}>{site.betrieb.email}</a>
  </p>
</RechtsLayout>
