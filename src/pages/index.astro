---
/**
 * =============================================================================
 *  REFERENZ-SEITE – wird beim Kunden vollständig ersetzt
 * =============================================================================
 *  Zweck: (1) `npm run dev` läuft sofort, (2) der technische Standard ist
 *  sichtbar, (3) die Verhaltens-Bausteine sind live vorführbar.
 *
 *  Sie zeigt, wie eine portierte Seite aussieht:
 *   - jede Sektion eine eigene Komponente unter src/components/
 *   - AUSSCHLIESSLICH Tokens (var(--raum-*), var(--schrift-*), var(--farbe-*))
 *   - keine feste Pixelbreite, kein Farbwert im Markup
 *
 *  Beim Kunden: diesen Ordner leeren und die Sektionen aus dem Claude Design
 *  portieren. Siehe CLAUDE.md -> „Portier-Rezept".
 * =============================================================================
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import Schwebeknopf from '../components/Schwebeknopf.astro';
import Formular from '../components/Formular.astro';
import Einbettung from '../components/Einbettung.astro';
import Symbol from '../components/Symbol.astro';
import Oeffnungszeiten from '../components/Oeffnungszeiten.astro';
import { site } from '../../content.config';
import { bild } from '../lib/bilder';

/* Die Referenz benutzt bewusst ein echtes Bild aus fotos/: So wird die
   Bild-Pipeline bei JEDEM Build durchlaufen. Wäre hier kein Bild, würde ein
   kaputter Bildpfad still bleiben, bis er beim ersten Kunden auffällt. */
const heroBild = bild('hero.jpg');
/* Vier echte Fotos aus fotos/ – damit der Slider auch die Bild-Kette faehrt
   und nicht nur seine Mechanik. */
const galerieBilder = ['galerie-1.jpg', 'galerie-2.jpg', 'galerie-3.jpg', 'galerie-4.jpg']
  .map((n) => bild(n))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));
---

<BaseLayout pfad="/">
  <Kopf aktuell="/" />

  <main id="inhalt">
    <section class="hero">
      <div class="container">
        <p class="hero__eyebrow">{site.betrieb.claim}</p>
        <h1 class="hero__titel">{site.betrieb.name}</h1>
        <p class="hero__text">{site.betrieb.kurzbeschreibung}</p>
      </div>

      {heroBild && (
        <div class="hero__bild">
          {/* <Picture> statt <Image>: liefert WebP fuer moderne Browser UND
              eine JPEG-Ersatzfassung. Ohne sie zeigen Macs mit aelterem
              Betriebssystem KEIN einziges Foto - dort haengt WebP am System,
              nicht an der Safari-Version. Das sind genau die Rechner, die in
              Betrieben als Buero-Mac weiterlaufen. */}
          <Picture
            formats={['webp']}
            fallbackFormat="jpeg"
            src={heroBild}
            alt="Referenz-Bild: zeigt, dass die Bild-Pipeline aus fotos/ funktioniert"
            widths={[480, 768, 1200, 1800, 2400]}
            sizes="100vw"
            quality={72}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
    </section>

    <section class="block" data-reveal>
      <div class="container">
        <h2><Symbol name="wrench" /> Was der Motor liefert</h2>
        <ul class="liste">
          <li><strong>Meta je Seite</strong> – Titel, Description, Canonical, OG-Bild, JSON-LD</li>
          <li><strong>Fluide Skala</strong> – jede Länge ein Token, responsiv von 350 bis 1440 px</li>
          <li><strong>Verhaltens-Bausteine</strong> – Tabs, Filter, Slider, Akkordeon, Lightbox, Mobilmenü, Vergleich</li>
          <li><strong>Formular-Motor</strong> – Felder aus der Config, Honeypot, Resend</li>
          <li><strong>demo/live</strong> – ein Wort schaltet Balken, Formular, tel:, Indexierung</li>
          <li><strong>Prüf-Tor</strong> – <code>npm run check</code> lässt Fehlendes nicht durch</li>
        </ul>
      </div>
    </section>

    {/* Akkordeon – nativ <details>, funktioniert ohne JS. */}
    <section class="block block--getoent" data-reveal>
      <div class="container">
        <h2>Verhaltens-Baustein: Akkordeon</h2>
        <div class="akkordeon" data-akkordeon data-akkordeon-exklusiv>
          <details>
            <summary>Wo kommt das Design her?</summary>
            <div class="akkordeon__inhalt">
              <p>Aus Claude Design. Der Motor gibt Struktur, Technik und Standard vor – nie das Aussehen.</p>
            </div>
          </details>
          <details>
            <summary>Wo stehen die Inhalte?</summary>
            <div class="akkordeon__inhalt">
              <p>Was der Motor braucht (Betriebsdaten, Meta, Preisliste, Recht), steht in content.config.ts. Was man sieht, kommt aus dem Design.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    {/* 2-Klick-Einbettung – der Standardweg des Motors für eine bediente Karte
        oder ein Video (CLAUDE.md 7a). Sie steht hier, damit das Bedien-Tor sie
        wirklich anfährt: Bis 05.08.2026 hat keine Prüfung je hinter diesen
        Klick geschaut, und in einem Kundenprojekt fiel die Karte danach auf
        einen 150-Pixel-Streifen zusammen. Vor dem Klick geht kein Byte raus. */}
    <section class="block block--getoent" data-reveal>
      <div class="container container--schmal">
        <h2>Verhaltens-Baustein: 2-Klick-Einbettung</h2>
        <p class="block__intro">
          Erst der Klick lädt den fremden Rahmen. Vorher wird nichts übertragen –
          deshalb braucht die Seite dafür kein Banner.
        </p>
        <Einbettung
          url="https://muster.example/karte"
          titel="Anfahrt (Muster)"
          anbieter="Muster Karten"
          format="4 / 3"
        />
      </div>
    </section>

    {/* SLIDER – bis 05.08.2026 stand er in jedem Lauf des Bedien-Tors unter
        „NICHT GEPRÜFT: auf keiner der Seiten vorgekommen". Ein Baustein, den
        keine Referenzseite baut, wird von keinem Tor gefahren; sein erster
        echter Einsatz wäre beim Kunden gewesen. Genau dabei fielen die
        falschen ARIA-Rollen auf, die er jahrelang trug.
        Ohne Auto-Durchlauf: Der macht die Bedien-Prüfung unzuverlässig, weil
        er mitten in der Messung weiterschaltet. */}
    <section class="block" data-reveal>
      <div class="container container--schmal">
        <h2>Verhaltens-Baustein: Slider</h2>
        <p class="block__intro">
          Blättert mit Knöpfen, Punkten und Wischen. Wie schnell er gleitet,
          bestimmt das Design über <code>scroll-behavior</code>.
        </p>
        <div class="slider" data-slider>
          <div class="slider__spur" data-slider-spur>
            {galerieBilder.map((b, i) => (
              <div class="slider__folie">
                <Picture
                  formats={['webp']}
                  fallbackFormat="jpeg"
                  src={b}
                  alt={`Referenz-Bild ${i + 1} von ${galerieBilder.length} im Slider`}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 800px) 720px, 100vw"
                  quality={70}
                />
              </div>
            ))}
          </div>
          <div class="slider__bedienung">
            <button type="button" class="slider__pfeil" data-slider-zurueck aria-label="Vorheriges Bild">‹</button>
            <div class="slider__punkte" data-slider-punkte></div>
            <button type="button" class="slider__pfeil" data-slider-vor aria-label="Nächstes Bild">›</button>
          </div>
        </div>
      </div>
    </section>

    {/* ÖFFNUNGSZEITEN MIT ABWEICHUNGEN – steht hier aus demselben Grund wie die
        Einbettung darüber: Was die Referenzseite nicht baut, prüft kein Tor.
        Der Baustein rechnete bis 05.08.2026 beim BAUEN, wann eine Abweichung
        vorbei ist. Ein Betriebsurlaub, der nach dem letzten Bau endet, wäre
        damit für immer stehengeblieben – und niemand hätte es gemeldet, weil
        die Seite dabei nicht kaputt aussieht, nur falsch. */}
    <section class="block block--getoent" data-reveal>
      <div class="container container--schmal">
        <h2>Verhaltens-Baustein: Öffnungszeiten</h2>
        <p class="block__intro">
          Die Wochenzeiten plus Feiertage und Betriebsurlaub. Ob eine Abweichung
          noch bevorsteht, entscheidet der Browser – in der Zeitzone des Betriebs.
        </p>
        <Oeffnungszeiten />
      </div>
    </section>

    <section class="block" data-reveal>
      <div class="container container--schmal">
        <h2>Formular-Motor</h2>
        <p class="block__intro">
          Die Felder kommen aus der Config. In der Vorschau ist es voll bedienbar – nur abgeschickt wird nichts.
        </p>
        <Formular id="kontakt" class="formular--referenz" />
      </div>
    </section>
  </main>

  <Fuss />
  {/* Der Motor zeigt ihn auf der Referenzseite, damit die Tore ihn wirklich
      anfahren – im Klon entscheidet das Design, ob und wo er steht. */}
  <Schwebeknopf />
</BaseLayout>

<style>
  /* So sieht portierter Code aus: NUR Tokens, keine festen Pixel, keine Farbwerte. */

  /* Der Slider braucht nur zwei Dinge, um zu funktionieren: eine Spur, die
     waagrecht scrollt, und Folien, die ihre Breite halten. Alles Weitere
     bestimmt beim Kunden das Design. */
  .slider__spur {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: var(--raum-xs);
    scrollbar-width: none;
  }
  .slider__spur::-webkit-scrollbar { display: none; }
  .slider__folie {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .slider__folie :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .slider__bedienung {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--raum-xs);
    margin-top: var(--raum-xs);
  }
  .slider__pfeil {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius);
    background: none;
    color: inherit;
    font-size: var(--schrift-l);
    cursor: pointer;
  }
  .slider__punkte {
    display: flex;
    gap: var(--raum-3xs);
  }
  .slider__punkte :global(.slider-punkt) {
    min-width: 44px;
    min-height: 44px;
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
  }
  .slider__punkte :global(.slider-punkt)::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--farbe-linie);
  }
  .slider__punkte :global(.slider-punkt.ist-aktiv)::after {
    background: var(--farbe-primaer);
  }


  .hero {
    padding-block: var(--raum-3xl) var(--raum-2xl);
  }
  .hero__eyebrow {
    font-size: var(--schrift-s);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--farbe-primaer);
    margin-bottom: var(--raum-2xs);
  }
  .hero__titel {
    font-size: var(--schrift-4xl);
  }
  .hero__text {
    margin-top: var(--raum-s);
    max-width: 44ch;
    font-size: var(--schrift-l);
  }
  .hero__bild {
    margin-top: var(--raum-l);
  }
  .hero__bild :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  .block {
    padding-block: var(--raum-2xl);
  }
  .block--getoent {
    background: var(--farbe-flaeche, var(--farbe-flaeche-weich));
  }
  .block h2 {
    font-size: var(--schrift-2xl);
    margin-bottom: var(--raum-m);
  }
  .block__intro {
    margin-bottom: var(--raum-m);
    max-width: 60ch;
  }

  .liste {
    display: grid;
    gap: var(--raum-xs);
    /* min() verhindert Überlauf auf schmalen Screens – Pflichtmuster für Grids. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
  }
  .liste li {
    padding: var(--raum-s);
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius);
  }

  .akkordeon {
    display: grid;
    gap: var(--raum-2xs);
    max-width: 60ch;
  }
  .akkordeon details {
    border-bottom: 1px solid var(--farbe-linie);
  }
  .akkordeon summary {
    cursor: pointer;
    padding-block: var(--raum-xs);
    font-weight: 600;
  }
  .akkordeon__inhalt {
    padding-bottom: var(--raum-xs);
    overflow: hidden;
  }

  .formular--referenz {
    display: grid;
    gap: var(--raum-s);
    max-width: 40rem;
  }

</style>
