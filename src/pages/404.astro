---
/**
 * Technische Fehlerseite. Bewusst schlicht und motor-eigen: Sie muss existieren
 * und funktionieren, braucht aber kein Design aus Claude Design.
 *
 * MIT KOPF UND FUSS – und das ist keine Kosmetik. Vorher rendete diese Seite
 * nur den Rumpf: keine Kopfleiste, keine Navigation, keine Fußzeile, kein
 * Impressums-Link. Wer über einen alten Google-Treffer hier landet, hatte damit
 * genau EINEN Weg („Zur Startseite") und sah die Pflichtangaben nicht – und
 * eine 404 aus einer Suchmaschine ist oft der Erstkontakt mit dem Betrieb.
 *
 * Statt das zu beheben, stand die Ausnahme lange im Prüf-Tor: Es übersprang
 * `404.html` bei der Pflicht „Impressum und Datenschutz von JEDER Seite
 * erreichbar", mit der Begründung, sonst würde jeder Build rot. Das ist der
 * Denkfehler: **Eine Ausnahme im Prüf-Tor, die einen Mangel des Motors deckt,
 * ist keine Ausnahme, sondern ein unerledigter Fehler.** Wird der Motor selbst
 * rot, gehört der Motor repariert – nicht die Prüfung.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { site } from '../../content.config';
---

<BaseLayout
  pfad="/404"
  titel="Seite nicht gefunden"
  beschreibung={`Die aufgerufene Seite gibt es nicht. Zurück zur Startseite von ${site.betrieb.name}.`}
  noindex
>
  <Kopf />

  <main id="inhalt" class="fehler">
    <div class="container container--schmal fehler__inner">
      <p class="fehler__code">Fehler 404</p>
      <h1>Diese Seite gibt es nicht</h1>
      <p>Die aufgerufene Seite wurde nicht gefunden.</p>
      <a class="fehler__link" href="/">← Zur Startseite</a>
    </div>
  </main>

  <Fuss />
</BaseLayout>

<style>
  .fehler {
    min-height: 60vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: var(--raum-2xl);
  }
  .fehler__inner {
    display: grid;
    gap: var(--raum-xs);
    justify-items: center;
  }
  .fehler__code {
    font-size: var(--schrift-s);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }
  .fehler h1 {
    font-size: var(--schrift-2xl);
  }
  .fehler__link {
    margin-top: var(--raum-s);
    font-weight: 600;
  }
</style>
